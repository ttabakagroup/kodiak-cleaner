<Window x:Class="KodiakCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KodiakCleaner.App.Views"
        xmlns:vm="clr-namespace:KodiakCleaner.App.ViewModels"
        Title="{Binding WindowTitle}" Width="1180" Height="760" MinWidth="900" MinHeight="580"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Which view renders which page -->
        <DataTemplate DataType="{x:Type vm:CleanerViewModel}"><views:CleanerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryViewModel}"><views:RegistryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}"><views:ProgramsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}"><views:DuplicatesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiskAnalyzerViewModel}"><views:DiskAnalyzerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriverCleanerViewModel}"><views:DriverCleanerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmptyFoldersViewModel}"><views:EmptyFoldersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExtensionsViewModel}"><views:ExtensionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargeFilesViewModel}"><views:LargeFilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HashCheckerViewModel}"><views:HashCheckerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MassRenameViewModel}"><views:MassRenameView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduledTasksViewModel}"><views:ScheduledTasksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}"><views:SystemInfoView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RestoreViewModel}"><views:RestoreView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WiperViewModel}"><views:WiperView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BootTimerViewModel}"><views:BootTimerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizeViewModel}"><views:OptimizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:IntegrityCheckViewModel}"><views:IntegrityCheckView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>

        <DataTemplate x:Key="NavItem" DataType="{x:Type vm:NavPage}">
            <!-- Hovering any entry shows its name, which matters most when the sidebar is collapsed to icons. -->
            <RadioButton GroupName="Nav" Style="{StaticResource NavButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                <StackPanel x:Name="Row" Orientation="Horizontal">
                    <Grid x:Name="IconBox" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="IconText" Text="{Binding Glyph}" Style="{StaticResource Icon}" />
                        <!-- Optional badge over the bottom right of the icon (Drive Wiper: a bin on the drive). -->
                        <TextBlock Text="{Binding Badge}" Style="{StaticResource Icon}" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-4"
                                   Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock x:Name="Label" Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <DataTemplate.Triggers>
                <!-- Collapsed: bigger icons, centered, no names. -->
                <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="Row" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="IconBox" Property="Margin" Value="0" />
                    <Setter TargetName="IconText" Property="FontSize" Value="20" />
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Width, limits and the draggable edge are set in MainWindow.xaml.cs (ApplySidebar). -->
            <ColumnDefinition x:Name="SidebarColumn" Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo and name: click to go back to the Cleaner -->
                <Button DockPanel.Dock="Top" Command="{Binding HomeCommand}" Click="Logo_Click" ToolTip="Go to the Cleaner" Margin="10,14,10,18" Padding="8,8"
                        HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="Transparent">
                    <DockPanel>
                        <!-- The bear does a little dance on hover and click (LogoDance; skipped when animations are off). -->
                        <Image x:Name="Logo" DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- The name shrinks to fit when the sidebar is dragged narrower, and hides when it's collapsed. -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="10,0,0,0"
                                 Visibility="{Binding SidebarCollapsed, Converter={StaticResource NotVis}}">
                        <StackPanel VerticalAlignment="Center">
                            <!-- A bit bigger than every other text, page titles included (Ted's request). -->
                            <TextBlock Style="{StaticResource Wordmark}" FontSize="29">
                                <Run Text="Kodiak" Foreground="{DynamicResource Brand1}" /><Run Text=" Cleaner" Foreground="{DynamicResource Brand2}" />
                            </TextBlock>
                            <TextBlock Text="{Binding VersionName}" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding BadgeText}" />
                            </Border>
                        </StackPanel>
                        </Viewbox>
                    </DockPanel>
                </Button>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <!-- A divider and some space set Settings and About apart from the scrolling list above, so the
                         Tools never seem to run into them, collapsed or on a short window (Ted, 0.8.29). -->
                    <Border DockPanel.Dock="Top" Height="1" Margin="22,8,22,10" Background="{DynamicResource Line}" />
                    <!-- Bottom right: the paperclip (above) locks or frees the width, the arrows collapse the sidebar to icons.
                         Collapsed, they sit under Settings and About instead. -->
                    <StackPanel VerticalAlignment="Bottom">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="DockPanel.Dock" Value="Right" />
                                <Setter Property="Margin" Value="0,0,10,2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                        <Setter Property="DockPanel.Dock" Value="Bottom" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,6,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding ToggleSidebarLockCommand}" Margin="0,0,0,2"
                                Visibility="{Binding ShowPaperclip, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarIconButton}">
                                    <Setter Property="ToolTip" Value="Width locked at the default. Click to unlock, then drag the sidebar's edge to resize it." />
                                    <Setter Property="AutomationProperties.Name" Value="Unlock Sidebar Width" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SidebarLocked}" Value="False">
                                            <Setter Property="ToolTip" Value="Drag the sidebar's edge to resize it. Click to reset to the default width and lock it." />
                                            <Setter Property="AutomationProperties.Name" Value="Reset and Lock Sidebar Width" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <!-- A paperclip: on its side when locked, upright when the width can be adjusted. -->
                            <Path Data="M 9,6 L 9,16.5 A 2.5,2.5 0 0 1 4,16.5 L 4,4.5 A 4,4 0 0 1 12,4.5 L 12,17 A 5.5,5.5 0 0 1 1,17 L 1,7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="23" Stretch="None">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="LayoutTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidebarLocked}" Value="False">
                                                <Setter Property="LayoutTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Command="{Binding ToggleSidebarCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarIconButton}">
                                    <Setter Property="ToolTip" Value="Collapse the sidebar to icons" />
                                    <Setter Property="AutomationProperties.Name" Value="Collapse Sidebar" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                            <Setter Property="ToolTip" Value="Expand the sidebar" />
                                            <Setter Property="AutomationProperties.Name" Value="Expand Sidebar" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="M 7,2 L 2,7 L 7,12 M 13,2 L 8,7 L 13,12" Width="15" Height="14" Stretch="None" RenderTransformOrigin="0.5,0.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="-1" /></Setter.Value></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FooterPages}" ItemTemplate="{StaticResource NavItem}" VerticalAlignment="Bottom" />
                </DockPanel>
                <ScrollViewer Focusable="False">
                    <!-- Collapsed, the scroll bar would push the icons off center, so it hides (the wheel still scrolls). -->
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="Cleaning" Style="{StaticResource GroupHeading}" Margin="24,0,0,6"
                                   Visibility="{Binding SidebarCollapsed, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding MainPages}" ItemTemplate="{StaticResource NavItem}" />
                        <!-- Tools start open (Ted, 0.8.11); click the heading to fold them away. Collapsed, a line stands in for it. -->
                        <Border Height="1" Margin="22,10,22,8" Background="{DynamicResource Line}"
                                Visibility="{Binding SidebarCollapsed, Converter={StaticResource BoolToVis}}" />
                        <ToggleButton Style="{StaticResource GroupToggle}" IsChecked="{Binding ToolsExpanded}"
                                      Visibility="{Binding SidebarCollapsed, Converter={StaticResource NotVis}}"
                                      ToolTip="Show or hide the tools" AutomationProperties.Name="Tools">
                            <TextBlock Text="Tools" />
                        </ToggleButton>
                        <ItemsControl ItemsSource="{Binding ToolPages}" ItemTemplate="{StaticResource NavItem}"
                                      Visibility="{Binding ToolsVisible, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="SidebarEdge" Grid.Column="0" Style="{StaticResource SidebarSplitter}" DragCompleted="SidebarEdge_DragCompleted"
                      ToolTip="Drag to resize the sidebar" />

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <!-- Running as a standard user is information, not a warning, so it takes the color scheme's accent tint like the
                 notice below and matches Honey, Classic and Glacier, light or dark (Ted, 0.8.29). -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,10"
                    Visibility="{Binding IsNotAdministrator, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}"
                               VerticalAlignment="Top" Margin="0,2,12,0" />
                    <Button DockPanel.Dock="Right" Margin="0" Command="{Binding RestartAsAdminCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Restart as Administrator" />
                        </StackPanel>
                    </Button>
                    <!-- Laid out as a short list (Ted, 2026-10-23): what needs administrator rights, then what runs faster with them. -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" TextElement.Foreground="{DynamicResource Text}">
                        <TextBlock Text="Running as a standard user" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Text="•  Windows temporary files and crash dumps need administrator rights to clean." />
                        <TextBlock TextWrapping="Wrap" Text="•  All users' startup entries need administrator rights." />
                        <TextBlock Text="Faster as administrator" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Text="•  Disk Analyzer and Duplicate Finder read whole drives straight from the drive's file table instead of folder by folder." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="{DynamicResource AccentTint}" Padding="20,10"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource LinkButton}" Margin="0" Click="DismissNotice_Click" />
                    <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="{DynamicResource AccentTint}" Padding="20,10"
                    Visibility="{Binding ShowDonationBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Click="DismissDonation_Click" />
                    <Button DockPanel.Dock="Right" Content="Donate on Ko-fi" Style="{StaticResource LinkButton}" Margin="16,0,0,0" Click="Donate_Click" />
                    <TextBlock Text="&#xEB51;" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentText}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Kodiak Cleaner is made for free in spare time. A donation, however small, really keeps the work going." />
                </DockPanel>
            </Border>
            <views:PageHost Page="{Binding CurrentContent}" x:Name="Pages" Margin="32,28,32,24" />
        </DockPanel>

        <!-- Work still running on another page: a small card in the bottom right corner with what it's doing and how far along
             it is, in the scheme's colors and accent. Clicking it opens that page; the X hides it until the next task (Ted, 2026-10-23). -->
        <Grid x:Name="TaskCard" Grid.Column="1" Width="264" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
              Visibility="{Binding HasCornerTask, Converter={StaticResource BoolToVis}}">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Button Command="{Binding OpenCornerTaskCommand}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}"
                    ToolTip="{Binding CornerPageTitle, StringFormat=Open {0}}" AutomationProperties.Name="{Binding CornerTask.Title}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusCard}" Padding="14,12,14,14" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentTint}" Margin="0,0,10,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CornerPageGlyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,26,0">
                        <TextBlock Text="{Binding CornerTask.Title}" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CornerPageTitle}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="6" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentTint}"
                                     Minimum="0" Maximum="100" Value="{Binding CornerTask.PercentValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding CornerTask.NoPercent, Mode=OneWay}" />
                        <!-- Without a percentage (a folder walk, a Windows tool that doesn't say) the bar just moves and this says so. -->
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" MinWidth="34" TextAlignment="Right" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource AccentText}" Text="{Binding CornerTask.PercentText}"
                                   Visibility="{Binding CornerTask.HasPercent, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <!-- Elapsed time, and the time left once there's enough progress to tell (Ted, 2026-10-23). -->
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding CornerTask.TimeText}" />
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding CornerMore}"
                               Visibility="{Binding HasCornerMore, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
            <Button Style="{StaticResource SidebarIconButton}" Width="26" Height="26" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding HideCornerTaskCommand}" ToolTip="Hide Until the Next Task" AutomationProperties.Name="Hide">
                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
            </Button>
        </Grid>
    </Grid>
</Window>
