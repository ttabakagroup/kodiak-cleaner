<Window x:Class="KodiakCleaner.App.NewStartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Startup Programs" Width="760" Height="480" MinWidth="520" MinHeight="320"
        Icon="pack://application:,,,/Assets/app.ico" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Pops up when programs have added themselves to startup: keep, disable or delete each one. -->
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="22" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="These now start when you sign in to Windows. Choose what to do with each one. Disable can be undone on the Startup page; Delete is backed up first and can be restored from Startup &gt; History. If a program has its own &quot;Start with Windows&quot; setting, turn that off in the program, or it may add itself back." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Keep All" IsCancel="True" Click="KeepAll_Click" />
                <Button Style="{StaticResource AccentButton}" IsDefault="True" Margin="0" Click="Apply_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Apply" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Content="Open Startup" HorizontalAlignment="Left" Click="OpenStartup_Click" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,6">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" MinWidth="120"
                                          VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="{Binding Name}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SettingTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    <TextBlock Text="{Binding WhyBack}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding CameBack, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
