<Window x:Class="KodiakCleaner.App.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight" MinWidth="420" MaxWidth="560"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Every confirm, warning and message in Kodiak Cleaner: themed like the rest of it (colors, fonts and accent). -->
    <StackPanel Margin="26,22,26,20">
        <DockPanel>
            <Border x:Name="Badge" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Top"
                    Background="{DynamicResource AccentTint}">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentText}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" FontSize="18" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <!-- A long message (KodiakCleaner.exe /help started without a console) scrolls instead of running off the screen. -->
        <ScrollViewer x:Name="BodyScroll" Margin="54,10,0,0" MaxHeight="520" VerticalScrollBarVisibility="Auto" Focusable="False">
            <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>
        <Border x:Name="CautionBox" Margin="54,12,0,0" Padding="12,9" CornerRadius="{DynamicResource Radius}" Visibility="Collapsed"
                Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1">
            <TextBlock x:Name="CautionText" TextWrapping="Wrap" Foreground="{DynamicResource WarnText}" />
        </Border>
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
    </StackPanel>
</Window>
