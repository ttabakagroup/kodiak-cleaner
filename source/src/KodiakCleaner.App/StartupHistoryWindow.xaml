<Window x:Class="KodiakCleaner.App.StartupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KodiakCleaner.App.Views"
        Title="Startup History" Width="1120" Height="640" MinWidth="640" MinHeight="400"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Startup > History: every startup entry Kodiak Cleaner has seen; removed ones can be put back. -->
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                <TextBlock Text="Startup History" Style="{StaticResource PageTitle}" FontSize="22" />
            </StackPanel>
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Close" IsCancel="True" Click="Close_Click" />
                <Button Style="{StaticResource AccentButton}" Margin="0" Click="Restore_Click"
                        ToolTip="Puts the ticked entries (or the selected one) back in startup, on or off as they were.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Restore Selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button HorizontalAlignment="Left" Click="Forget_Click" ToolTip="Removes the ticked records from this history. Startup itself isn't changed.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Forget Selected" />
                </StackPanel>
            </Button>
        </DockPanel>

        <views:SearchBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,16" Placeholder="Search by name, command or location" />

        <Border Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="Grid" IsSynchronizedWithCurrentItem="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="AllBox" IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center" Click="All_Click" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="215" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding WhyBack}" />
                                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="170" IsReadOnly="True" />
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeen, StringFormat=g}" Width="140" IsReadOnly="True" />
                    <DataGridTextColumn Header="Removed" Binding="{Binding RemovedOn, StringFormat=g}" Width="140" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
