<!-- Lagoon: pale sky-blue paper, deep navy text, ocean-blue buttons and aqua highlights (dark mode). Colors come only from the
     theme tables in Ted's app standard; every control uses these keys, so nothing else holds a color. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#0A1424" />
    <SolidColorBrush x:Key="Surface" Color="#111E33" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#0D192C" />
    <!-- Tables: every other row, row hover, row separators and the column dividers you drag. -->
    <SolidColorBrush x:Key="RowAlt" Color="#0D192C" />
    <SolidColorBrush x:Key="RowHover" Color="#2E2EC4E8" />
    <SolidColorBrush x:Key="RowLine" Color="#20324B" />
    <SolidColorBrush x:Key="ColumnDivider" Color="#20324B" />
    <SolidColorBrush x:Key="Line" Color="#20324B" />
    <SolidColorBrush x:Key="Text" Color="#E8F1F8" />
    <SolidColorBrush x:Key="Muted" Color="#9FB3C8" />
    <SolidColorBrush x:Key="Link" Color="#5CC6F2" />
    <SolidColorBrush x:Key="Primary" Color="#5CC6F2" />
    <SolidColorBrush x:Key="OnPrimary" Color="#0A1424" />
    <SolidColorBrush x:Key="Accent" Color="#2EC4E8" />
    <SolidColorBrush x:Key="AccentText" Color="#5CC6F2" />
    <SolidColorBrush x:Key="AccentTint" Color="#2E2EC4E8" />
    <SolidColorBrush x:Key="Success" Color="#2DD4BF" />
    <SolidColorBrush x:Key="OnSuccess" Color="#0A1424" />
    <SolidColorBrush x:Key="ToggleOn" Color="#2DD4BF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#5F7896" />
    <SolidColorBrush x:Key="WarnBg" Color="#3A2A14" />
    <SolidColorBrush x:Key="WarnText" Color="#F6C88A" />
    <SolidColorBrush x:Key="WarnBorder" Color="#8A6A3A" />
    <SolidColorBrush x:Key="Danger" Color="#FF8A80" />
    <SolidColorBrush x:Key="DangerBg" Color="#C2362B" />
    <SolidColorBrush x:Key="DangerFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBorder" Color="#C2362B" />
    <SolidColorBrush x:Key="ChipBg" Color="#12324A" />
    <SolidColorBrush x:Key="ChipText" Color="#8EDCF5" />
    <SolidColorBrush x:Key="Brand1" Color="#E8F1F8" />
    <SolidColorBrush x:Key="Brand2" Color="#5CC6F2" />
    <SolidColorBrush x:Key="FocusRing" Color="#5CC6F2" />
    <CornerRadius x:Key="Radius">12</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <!-- Soft ring around a focused text box (Honey, Classic and Lagoon). -->
    <SolidColorBrush x:Key="FocusGlow" Color="#2E2EC4E8" />
    <!-- Fredoka for all text in every color scheme (Ted, 0.9.7): Regular and SemiBold are built in, so bold text is the real
         SemiBold face and switching schemes changes only colors and corners, never sizes. -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Fredoka</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Assets/Fonts/#Fredoka</FontFamily>
</ResourceDictionary>
