<!-- Glacier: calm, low-contrast blue-grey stone (dark mode). Colors come only from the theme tables in Ted's app standard;
     every control uses these keys, so nothing else holds a color. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#1E2528" />
    <SolidColorBrush x:Key="Surface" Color="#252D31" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#21292C" />
    <!-- Tables: every other row, row hover, row separators and the column dividers you drag. -->
    <SolidColorBrush x:Key="RowAlt" Color="#21292C" />
    <SolidColorBrush x:Key="RowHover" Color="#248FB6C7" />
    <SolidColorBrush x:Key="RowLine" Color="#333D42" />
    <SolidColorBrush x:Key="ColumnDivider" Color="#333D42" />
    <SolidColorBrush x:Key="Line" Color="#333D42" />
    <SolidColorBrush x:Key="Text" Color="#EAEEEE" />
    <SolidColorBrush x:Key="Muted" Color="#B7B9AE" />
    <SolidColorBrush x:Key="Link" Color="#8FB6C7" />
    <SolidColorBrush x:Key="Primary" Color="#8FB6C7" />
    <SolidColorBrush x:Key="OnPrimary" Color="#1E2528" />
    <SolidColorBrush x:Key="Accent" Color="#8FB6C7" />
    <SolidColorBrush x:Key="AccentText" Color="#8FB6C7" />
    <SolidColorBrush x:Key="AccentTint" Color="#248FB6C7" />
    <SolidColorBrush x:Key="Success" Color="#8FB6C7" />
    <SolidColorBrush x:Key="OnSuccess" Color="#1E2528" />
    <SolidColorBrush x:Key="ToggleOn" Color="#8FB6C7" />
    <SolidColorBrush x:Key="ControlBorder" Color="#AEB9BE" />
    <SolidColorBrush x:Key="WarnBg" Color="#252D31" />
    <SolidColorBrush x:Key="WarnText" Color="#B39690" />
    <SolidColorBrush x:Key="WarnBorder" Color="#B39690" />
    <SolidColorBrush x:Key="Danger" Color="#B39690" />
    <SolidColorBrush x:Key="DangerBg" Color="#252D31" />
    <SolidColorBrush x:Key="DangerFg" Color="#B39690" />
    <SolidColorBrush x:Key="DangerBorder" Color="#333D42" />
    <SolidColorBrush x:Key="ChipBg" Color="#A9BDB4" />
    <SolidColorBrush x:Key="ChipText" Color="#26301F" />
    <SolidColorBrush x:Key="Brand1" Color="#EAEEEE" />
    <SolidColorBrush x:Key="Brand2" Color="#EAEEEE" />
    <SolidColorBrush x:Key="FocusRing" Color="#8FB6C7" />
    <CornerRadius x:Key="Radius">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <!-- Soft ring around a focused text box (Honey only). -->
    <SolidColorBrush x:Key="FocusGlow" Color="#00000000" />
    <!-- Fredoka for all text in every color scheme (Ted, 0.9.7): Regular and SemiBold are built in, so bold text is the real
         SemiBold face and switching schemes changes only colors and corners, never sizes. -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Fredoka</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Assets/Fonts/#Fredoka</FontFamily>
</ResourceDictionary>
