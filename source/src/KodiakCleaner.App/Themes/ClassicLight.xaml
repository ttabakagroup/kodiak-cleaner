<!-- Classic: the neutral greys and blue of PCSweep's first versions, a familiar Windows look (light mode). Free for everyone.
     Colors come only from this table; every control uses these keys, so nothing else holds a color. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F2F4F7" />
    <!-- Tables: every other row, row hover, row separators and the column dividers you drag. -->
    <SolidColorBrush x:Key="RowAlt" Color="#F1F4F8" />
    <SolidColorBrush x:Key="RowHover" Color="#E6EDF8" />
    <SolidColorBrush x:Key="RowLine" Color="#DCE1E7" />
    <SolidColorBrush x:Key="ColumnDivider" Color="#9AA3AE" />
    <SolidColorBrush x:Key="Line" Color="#E3E6EA" />
    <SolidColorBrush x:Key="Text" Color="#1B1F24" />
    <SolidColorBrush x:Key="Muted" Color="#5F6670" />
    <SolidColorBrush x:Key="Link" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Primary" Color="#2563EB" />
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentText" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentTint" Color="#2E2563EB" />
    <SolidColorBrush x:Key="Success" Color="#16A34A" />
    <SolidColorBrush x:Key="OnSuccess" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleOn" Color="#2563EB" />
    <SolidColorBrush x:Key="ControlBorder" Color="#828A95" />
    <SolidColorBrush x:Key="WarnBg" Color="#FFF4CE" />
    <SolidColorBrush x:Key="WarnText" Color="#5C4400" />
    <SolidColorBrush x:Key="WarnBorder" Color="#D9B84A" />
    <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerBg" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBorder" Color="#C42B1C" />
    <SolidColorBrush x:Key="ChipBg" Color="#E8EEFD" />
    <SolidColorBrush x:Key="ChipText" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brand1" Color="#1B1F24" />
    <SolidColorBrush x:Key="Brand2" Color="#2563EB" />
    <SolidColorBrush x:Key="FocusRing" Color="#2563EB" />
    <CornerRadius x:Key="Radius">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <!-- Soft ring around a focused text box. -->
    <SolidColorBrush x:Key="FocusGlow" Color="#2E2563EB" />
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI</FontFamily>
</ResourceDictionary>
