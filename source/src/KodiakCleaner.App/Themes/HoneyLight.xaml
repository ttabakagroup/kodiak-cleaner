<!-- Honey: warm cream, bear-brown text and honey-gold accents (light mode). Colors come only from the theme tables in Ted's app standard;
     every control uses these keys, so nothing else holds a color. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#F5EFE6" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FBF7F0" />
    <!-- Tables: every other row, row hover, row separators and the column dividers you drag. -->
    <SolidColorBrush x:Key="RowAlt" Color="#FBF7F0" />
    <SolidColorBrush x:Key="RowHover" Color="#2ED9A441" />
    <SolidColorBrush x:Key="RowLine" Color="#E8DFD1" />
    <SolidColorBrush x:Key="ColumnDivider" Color="#E8DFD1" />
    <SolidColorBrush x:Key="Line" Color="#E8DFD1" />
    <SolidColorBrush x:Key="Text" Color="#3D2B1F" />
    <SolidColorBrush x:Key="Muted" Color="#6F6152" />
    <SolidColorBrush x:Key="Link" Color="#6B4A34" />
    <SolidColorBrush x:Key="Primary" Color="#6B4A34" />
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#D9A441" />
    <SolidColorBrush x:Key="AccentText" Color="#86611E" />
    <SolidColorBrush x:Key="AccentTint" Color="#2ED9A441" />
    <SolidColorBrush x:Key="Success" Color="#7C9463" />
    <SolidColorBrush x:Key="OnSuccess" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleOn" Color="#7C9463" />
    <SolidColorBrush x:Key="ControlBorder" Color="#B27C4B" />
    <SolidColorBrush x:Key="WarnBg" Color="#F7DDD4" />
    <SolidColorBrush x:Key="WarnText" Color="#A6452F" />
    <SolidColorBrush x:Key="WarnBorder" Color="#F7DDD4" />
    <SolidColorBrush x:Key="Danger" Color="#B4432E" />
    <SolidColorBrush x:Key="DangerBg" Color="#B4432E" />
    <SolidColorBrush x:Key="DangerFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBorder" Color="#B4432E" />
    <SolidColorBrush x:Key="ChipBg" Color="#F6E6C8" />
    <SolidColorBrush x:Key="ChipText" Color="#8A5A16" />
    <SolidColorBrush x:Key="Brand1" Color="#6B4A34" />
    <SolidColorBrush x:Key="Brand2" Color="#86611E" />
    <SolidColorBrush x:Key="FocusRing" Color="#86611E" />
    <CornerRadius x:Key="Radius">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <!-- Soft ring around a focused text box (Honey only). -->
    <SolidColorBrush x:Key="FocusGlow" Color="#2ED9A441" />
    <!-- Fredoka for all text in every color scheme (Ted, 0.9.7): Regular and SemiBold are built in, so bold text is the real
         SemiBold face and switching schemes changes only colors and corners, never sizes. -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Fredoka</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Assets/Fonts/#Fredoka</FontFamily>
</ResourceDictionary>
