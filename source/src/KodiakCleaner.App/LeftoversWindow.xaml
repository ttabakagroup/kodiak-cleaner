<Window x:Class="KodiakCleaner.App.LeftoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KodiakCleaner.App.Views"
        Width="720" Height="560" MinWidth="480" MinHeight="360"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Shown after a successful uninstall from Programs: pick which leftovers to remove. -->
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                <TextBlock Text="Remove Leftovers" Style="{StaticResource PageTitle}" FontSize="22" />
            </StackPanel>
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Keep Everything" IsCancel="True" Click="Keep_Click" />
                <Button x:Name="RemoveButton" Style="{StaticResource AccentButton}" Margin="0" Click="Remove_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Remove Selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Select All" Click="SelectAll_Click" />
                <Button Content="Clear" Click="Clear_Click" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl views:Placeholder.Text="Leftover files, folders and registry keys show here." x:Name="List" Padding="8,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Where}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
