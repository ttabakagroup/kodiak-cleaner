<UserControl x:Class="KodiakCleaner.App.Developer.DeveloperPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Development builds only. Release builds leave this whole folder out. -->
    <UserControl.Resources>
        <Style x:Key="StatusLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Width" Value="170" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Developer Mode" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Preview Kodiak Cleaner as a Free or Supporter user without a code. Badges show &quot;· Dev&quot; during a preview."
                           Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Free shows Kodiak Cleaner as everyone gets it. Supporter previews the Supporter perks." />
                <TextBlock Text="Preview Plan" Style="{StaticResource SettingTitle}" Margin="0,14,0,6" />
                <Border Style="{StaticResource SegmentHost}">
                    <ItemsControl ItemsSource="{Binding Previews}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="DevPreview" Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="Preview Name" Style="{StaticResource SettingTitle}" Margin="0,14,0,6" />
                <TextBox Text="{Binding PreviewName, UpdateSourceTrigger=LostFocus}" Tag="e.g. Jane Doe" MaxWidth="320" HorizontalAlignment="Left" Width="320" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Status" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal"><TextBlock Text="Build" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding BuildType}" Style="{StaticResource StatusValue}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Install Type" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding InstallType}" Style="{StaticResource StatusValue}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Signing Key" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding SigningKey}" Style="{StaticResource StatusValue}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Supporter Code" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding CodeState}" Style="{StaticResource StatusValue}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Current Preview" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding CurrentPreview}" Style="{StaticResource StatusValue}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Plan" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding PlanNow}" Style="{StaticResource StatusValue}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Perks Active Now" Style="{StaticResource StatusLabel}" /><TextBlock Text="{Binding PerksNow}" Style="{StaticResource StatusValue}" /></StackPanel>
                <Button Content="Reset Supporter Testing" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Reset to Default" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Puts every setting back to how it was when Kodiak Cleaner was first installed, after you confirm. Kept: the launch count, your Supporter code, update bookkeeping, scheduled cleanings, Cleaner history, and every backup, report and log." />
                <Button Command="{Binding ResetSettingsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Reset to Default" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
