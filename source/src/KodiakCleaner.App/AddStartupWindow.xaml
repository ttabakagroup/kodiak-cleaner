<Window x:Class="KodiakCleaner.App.AddStartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add to Startup" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Startup > Add: pick a program or a shortcut; a shortcut to it goes in the Startup folder. -->
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
            <TextBlock Text="Add to Startup" Style="{StaticResource PageTitle}" FontSize="22" />
        </StackPanel>
        <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="Pick a program or a shortcut. A shortcut to it goes in your Startup folder, so it starts when you sign in. You can turn it off or remove it here any time." />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Program or Shortcut" Style="{StaticResource SettingTitle}" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Browse" Click="Browse_Click" Margin="10,0,0,0" />
                    <TextBox x:Name="FileBox" TextChanged="FileBox_TextChanged" VerticalContentAlignment="Center" />
                </DockPanel>

                <TextBlock Text="Name" Style="{StaticResource SettingTitle}" Margin="0,16,0,0" />
                <TextBox x:Name="NameBox" Margin="0,6,0,0" VerticalContentAlignment="Center" />

                <DockPanel x:Name="MoveRow" Margin="0,16,0,0" Visibility="Collapsed">
                    <CheckBox x:Name="MoveSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Move the Shortcut" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Moves the shortcut into the Startup folder. Turn this off to copy it and leave the original where it is." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,16,0,0">
                    <CheckBox x:Name="AllUsersSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Start for Everyone on This PC" Style="{StaticResource SettingTitle}" />
                        <TextBlock x:Name="AllUsersCaption" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Uses the Startup folder shared by every account instead of only yours." />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="AddButton" Style="{StaticResource AccentButton}" Margin="0" Click="Add_Click" IsEnabled="False" IsDefault="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Add to Startup" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
