<Window x:Class="KodiakCleaner.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Getting Started: opens on the first launch (What's New opens after updates instead). -->
    <!-- Scrolls on small screens, where the longer Features list (0.8.24) wouldn't fit. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,28">
        <StackPanel Orientation="Horizontal">
            <!-- The bear says hello with a little dance when the window opens, and again on hover or click. -->
            <Image x:Name="Logo" Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome to" Style="{StaticResource Caption}" FontSize="14" />
                <TextBlock Style="{StaticResource Wordmark}" FontSize="28">
                    <Run Text="Kodiak" Foreground="{DynamicResource Brand1}" /><Run Text=" Cleaner" Foreground="{DynamicResource Brand2}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="SloganText" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" Margin="0,14,0,0" />
        <TextBlock Text="Getting Started" Style="{StaticResource PageTitle}" FontSize="22" Margin="0,20,0,0" />

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="1" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentText}" Width="26" />
                    <TextBlock TextWrapping="Wrap"><Run Text="Cleaner" FontWeight="SemiBold" /><Run Text=": pick what to remove, click Analyze to see the sizes, then Run Cleaner." /></TextBlock>
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="2" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentText}" Width="26" />
                    <TextBlock TextWrapping="Wrap"><Run Text="Registry and Startup" FontWeight="SemiBold" /><Run Text=": every registry fix is backed up first, and startup programs can be turned back on any time." /></TextBlock>
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="3" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentText}" Width="26" />
                    <TextBlock TextWrapping="Wrap"><Run Text="Settings" FontWeight="SemiBold" /><Run Text=": choose Honey, Classic or Glacier, an accent color, light or dark, and how Kodiak Cleaner fits into Windows." /></TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Features" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                <ItemsControl x:Name="FeatureList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,16,8">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentText}" Margin="0,3,8,0" VerticalAlignment="Top" />
                                <TextBlock TextWrapping="Wrap" FontSize="13"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Muted}" /></TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Success}" Margin="0,1,10,0" VerticalAlignment="Top" />
            <TextBlock TextWrapping="Wrap" Width="660"
                       Text="Everything stays on this PC. Kodiak Cleaner sends no usage data and shows no ads. It only goes online to check for updates, and only when you ask." />
        </StackPanel>

        <DockPanel Margin="0,24,0,0">
            <Button DockPanel.Dock="Right" Content="Get Started" Style="{StaticResource AccentButton}" Margin="0" IsDefault="True" IsCancel="True" Click="Close_Click" />
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}">
                <Run Text="By using Kodiak Cleaner you agree to the" />
                <Hyperlink Click="Terms_Click" Foreground="{DynamicResource Link}">Terms of Use</Hyperlink><Run Text="." />
            </TextBlock>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
