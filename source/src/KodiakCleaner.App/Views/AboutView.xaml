<UserControl x:Class="KodiakCleaner.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KodiakCleaner.App.Views">
    <!-- About has its own sidebar entry, under Settings. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Version, what's new, privacy and credits." Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Focusable="False">
            <!-- Fills the window like every other page (Ted, 0.8.12). -->
            <views:AboutPage />
        </ScrollViewer>
    </DockPanel>
</UserControl>
