<UserControl x:Class="KodiakCleaner.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A built-in document (Terms of Use, Privacy Policy): offline, in the app's theme. -->
    <Border Style="{StaticResource Card}" Padding="24">
        <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock x:Name="Bullet" DockPanel.Dock="Left" Text="•" Width="18"
                                   FontSize="{Binding DataContext.BodySize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="4,6,0,0" Foreground="{DynamicResource Muted}" Visibility="Collapsed" />
                        <TextBlock x:Name="Text" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                                   Margin="{Binding DataContext.ParagraphMargin, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   FontSize="{Binding DataContext.BodySize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   LineHeight="{Binding DataContext.LineHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Heading1">
                            <Setter TargetName="Text" Property="Style" Value="{StaticResource SectionTitle}" />
                            <Setter TargetName="Text" Property="FontSize" Value="{Binding DataContext.TitleSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <Setter TargetName="Text" Property="LineHeight" Value="NaN" />
                            <Setter TargetName="Text" Property="Margin" Value="0,0,0,4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Heading2">
                            <Setter TargetName="Text" Property="Style" Value="{StaticResource SectionTitle}" />
                            <Setter TargetName="Text" Property="FontSize" Value="{Binding DataContext.HeadingSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <Setter TargetName="Text" Property="LineHeight" Value="NaN" />
                            <Setter TargetName="Text" Property="Margin" Value="0,20,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Heading3">
                            <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Text" Property="Margin" Value="0,14,0,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                            <Setter TargetName="Bullet" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Text" Property="Margin" Value="0,6,0,0" />
                        </DataTrigger>
                        <!-- The first block starts flush with the card's padding (no gap above Why It Was Made's title). -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                            <Setter TargetName="Text" Property="Margin" Value="0,0,0,4" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
