<UserControl x:Class="KodiakCleaner.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Startup" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Programs that start when you sign in. Turning one off works like Task Manager's Disable and can be undone any time." />
            </StackPanel>
        </DockPanel>

        <!-- Batch actions: tick entries (or the header box for all), then turn them on or off together. -->
        <!-- The right-hand buttons wrap onto a second line in a narrow window instead of being cut off (Ted, 0.8.96).
             Each button keeps 8 px below it, so the row's own bottom margin is 8 rather than 16. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Command="{Binding DisableSelectedCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Disable Selected" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding EnableSelectedCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Enable Selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Command="{Binding AddCommand}" Margin="8,0,0,8"
                        ToolTip="Add a program or shortcut to startup.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding HistoryCommand}" Margin="8,0,0,8"
                        ToolTip="Every startup entry Kodiak Cleaner has seen. Put removed ones back from here.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="History" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh" Padding="14,0" MinWidth="0" Margin="8,0,0,8">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
                </Button>
                <Button Command="{Binding DeleteCommand}" Margin="8,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Remove Selected" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <local:SearchBox DockPanel.Dock="Top" Margin="0,0,0,16" Text="{Binding Filter}" Placeholder="Search by name, command or location" />

        <!-- Scheduled tasks that start a program at sign-in or when Windows starts (Ted, 0.8.89). They aren't startup
             entries, so they have their own card; turning one off or deleting it works like Tools > Scheduled Tasks. -->
        <!-- Both cards grow and shrink with the window; the startup list keeps two thirds of the room (Ted, 0.8.95) until
             the divider between them is dragged. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="180" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>
            <!-- Drag the grip between the cards to give either one more room (Ted, 0.8.99). -->
            <GridSplitter Grid.Row="1" Style="{StaticResource PaneRows}" local:PaneSplitter.Remember="startup" />
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                <DockPanel>
                    <!-- The button keeps its size; in a narrow window the title shortens with "..." instead of covering it. -->
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Command="{Binding OpenTasksCommand}" Margin="12,0,0,0"
                                ToolTip="See every scheduled task, back them up and restore deleted ones.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Open Scheduled Tasks" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Scheduled Tasks That Run at Startup" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="Scheduled Tasks That Run at Startup" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TasksSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,8" />
                    <DataGrid RowStyle="{StaticResource DetailsRow}" ItemsSource="{Binding StartupTasks}" SelectedItem="{Binding SelectedTask}"
                              IsSynchronizedWithCurrentItem="False" SelectionChanged="Tasks_SelectionChanged"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Enable" Command="{Binding TaskOnCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Disable" Command="{Binding TaskOffCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Delete Task" Command="{Binding TaskDeleteCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Task" Width="2*" MinWidth="160" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource Muted}"
                                                           Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="2*" MinWidth="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Starts" Binding="{Binding StartsWith}" Width="150" MinWidth="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" MinWidth="100" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="On" Width="80" MinWidth="80" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
                <DataGrid RowStyle="{StaticResource DetailsRow}" ItemsSource="{Binding View}" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding Selected}" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                          SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged">
                    <!-- Right-click an entry to turn it on or off, or remove it. Ctrl-click and Shift-click highlight several entries
                         (Ted, 0.8.49) and the menu acts on all of them; the buttons above use them when nothing is ticked. -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Enable" Command="{Binding EnableRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Disable" Command="{Binding DisableRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Remove From Startup" Command="{Binding RemoveRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="48" MinWidth="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="140" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Muted}"
                                                       Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="170" MinWidth="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="3*" MinWidth="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="150" MinWidth="110" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="On" Width="80" MinWidth="80" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
