<UserControl x:Class="KodiakCleaner.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Startup" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Programs that start when you sign in. Turning one off works like Task Manager's Disable and can be undone any time." />
            </StackPanel>
        </DockPanel>

        <!-- Batch actions: tick entries (or the header box for all), then turn them on or off together. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding DisableSelectedCommand}" Style="{StaticResource AccentButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Disable Selected" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding EnableSelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Enable Selected" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding DeleteCommand}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Remove Selected" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip="Refresh" Padding="14,0" MinWidth="0">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding HistoryCommand}"
                    ToolTip="Every startup entry Kodiak Cleaner has seen. Put removed ones back from here.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="History" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding AddCommand}"
                    ToolTip="Add a program or shortcut to startup.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Add" />
                </StackPanel>
            </Button>
        </DockPanel>

        <local:SearchBox DockPanel.Dock="Top" Margin="0,0,0,16" Text="{Binding Filter}" Placeholder="Search by name, command or location" />

        <Border Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding View}" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding Selected}" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged">
                <!-- Right-click an entry to turn it on or off, or remove it. Ctrl-click and Shift-click highlight several entries
                     (Ted, 0.8.49) and the menu acts on all of them; the buttons above use them when nothing is ticked. -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Enable" Command="{Binding EnableRowCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Disable" Command="{Binding DisableRowCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove From Startup" Command="{Binding RemoveRowCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                      IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="170" IsReadOnly="True" />
                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="3*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="150" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="On" Width="80" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
