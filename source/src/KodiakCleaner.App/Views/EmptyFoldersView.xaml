<UserControl x:Class="KodiakCleaner.App.Views.EmptyFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tc="clr-namespace:KodiakCleaner.App.Views"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Empty Folders" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Find folders left behind with nothing in them. Removed folders go to the Recycle Bin." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Text="Tick whole drives, folders, or both. Windows and program folders are always skipped." />
        </DockPanel>

        <!-- Search whole drives, one or many, or folders (Ted, 0.8.65). -->
        <Border DockPanel.Dock="Left" Width="290" Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Search In" Style="{StaticResource SectionTitle}" />
                <local:PlacesPicker DataContext="{Binding Places}" Margin="0,4,0,0" />
                <Button Content="Add Folder…" Command="{Binding BrowseCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <tc:TaskClock Margin="0,6,0,0" />
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="8,8,8,4">
                    <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" Margin="0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Remove Selected" />
                        </StackPanel>
                    </Button>
                    <WrapPanel>
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,8,6" />
                        <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0">
                    <ItemsControl ItemsSource="{Binding Found}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open"
                                            Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
