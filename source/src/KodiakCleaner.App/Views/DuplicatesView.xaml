<UserControl x:Class="KodiakCleaner.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Duplicate Finder" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,16,0"
                           Text="Finds files with identical contents. Removed copies go to the Recycle Bin, and one copy of each file is always kept." />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Left" Width="280" Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Search In" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Folders}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add Folder…" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                <TextBlock Text="Options" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="MB" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox DockPanel.Dock="Right" Width="60" Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Minimum File Size" VerticalAlignment="Center" />
                </DockPanel>
                <CheckBox Content="Names Must Match Too" IsChecked="{Binding MatchName}" Margin="0,10,0,0" />
                <CheckBox Content="Include Hidden Files" IsChecked="{Binding IncludeHidden}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Selection}" Style="{StaticResource Caption}" Margin="8,0,8,0" HorizontalAlignment="Right" />
                <DockPanel DockPanel.Dock="Bottom" Margin="8,8,8,4">
                    <Button DockPanel.Dock="Right" Command="{Binding DeleteCommand}" Margin="0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Remove Selected" />
                        </StackPanel>
                    </Button>
                    <!-- Wraps onto a second line when the window is narrow, so no button sits on top of another (Ted, 0.8.65). -->
                    <WrapPanel Margin="0,0,8,0">
                        <Button Content="Keep Newest" Command="{Binding SelectAllButNewestCommand}" ToolTip="Tick every copy except the newest one in each set" Margin="0,0,8,6" />
                        <Button Content="Keep Oldest" Command="{Binding SelectAllButOldestCommand}" ToolTip="Tick every copy except the oldest one in each set" Margin="0,0,8,6" />
                        <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Header}" />
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show" VerticalAlignment="Center"
                                                            Command="{Binding Group.Owner.OpenFolderCommand}" CommandParameter="{Binding}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Modified}" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="12,0" />
                                                    <!-- Name, then its folder underneath, so neither runs into the date and Show (Ted, 0.8.65). -->
                                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip="{Binding File.Path}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Folder, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
