<UserControl x:Class="KodiakCleaner.App.Views.FeedbackPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <StackPanel>
        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,0,0,12"
                Visibility="{Binding HasBuildNote, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BuildNote}" />
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Send a Message" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="Each button opens the Contact Us form on kodiakcleaner.app in your browser, with the topic picked. Nothing is sent until you press Send Message there."
                           Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <TextBlock Text="Feedback isn't set up in this build yet." Foreground="{DynamicResource WarnText}" Margin="0,8,0,0"
                           Visibility="{Binding IsNotConfigured, Converter={StaticResource BoolToVis}}" />
                <WrapPanel Margin="0,14,0,0">
                    <Button Command="{Binding SendFeedbackCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Send Feedback" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ReportBugCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEBE8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Report a Bug" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RequestFeatureCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Request a Feature" />
                        </StackPanel>
                    </Button>
                    <!-- Security (Ted, 0.8.24): replaces the small "report a security problem privately" link. Goes privately to Ted through the form. -->
                    <Button Command="{Binding ReportSecurityCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                            ToolTip="Report a security problem privately through the Contact Us form. Please don't post security problems in public issues.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Security" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Copy Details" Command="{Binding CopyDetailsCommand}" Margin="0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Details for Your Report" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Copy these into a bug report so the problem is easier to find. They never include your files, folders or anything you cleaned."
                                   Style="{StaticResource Caption}" Margin="0,4,16,0" />
                    </StackPanel>
                </DockPanel>
                <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius}" Padding="12,10" Margin="0,12,0,0">
                    <TextBlock Text="{Binding Details}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding RateTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="&#xE735;&#xE735;&#xE735;&#xE735;&#xE735;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" FontSize="20" Margin="0,8,0,0" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding RateText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Left" Command="{Binding StarCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Top" Margin="0,0,8,0"
                            Visibility="{Binding ShowStar, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Star on GitHub" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding RateNote}" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>

    </Grid>
</UserControl>
