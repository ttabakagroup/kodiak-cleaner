<UserControl x:Class="KodiakCleaner.App.Views.WiperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tc="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Command="{Binding RefreshCommand}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Drive Wiper" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Overwrite free space so deleted files can't be recovered, or securely erase whole drives you're giving away. Each drive type gets the right method." />
            </StackPanel>
        </DockPanel>

        <!-- The wipe's own section at the top (Ted, 0.8.113): only the wipe's progress, outside the scrolling area so it stays in
             view. Shown while wiping, then with the result until the next wipe or Refresh. Same width as the cards below. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16" HorizontalAlignment="Left"
                Width="{Binding ActualWidth, ElementName=WipeColumn}"
                Visibility="{Binding ShowWipeCard, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentTint}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding WipeGlyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WipeTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WipeDrive}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding WipeStep}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0"
                               Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <!-- The big percentage, like the Cleaner page's total; a Quick wipe or firmware erase can't tell, so the bar just moves. -->
                <TextBlock Grid.Column="2" Text="{Binding WipeTask.PercentText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="3" Command="{Binding CancelCommand}" VerticalAlignment="Center" Margin="16,0,0,0"
                        AutomationProperties.Name="Stop the Wipe" Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Height="10" Margin="0,16,0,0" Minimum="0" Maximum="100"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentTint}"
                             Value="{Binding WipeTask.PercentValue, Mode=OneWay}" IsIndeterminate="{Binding WipeTask.NoPercent, Mode=OneWay}"
                             AutomationProperties.Name="Wipe Progress" Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}" />
                <!-- Elapsed time and the time left, from the wipe's background task (Ted, 2026-10-23). -->
                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding WipeTask.TimeText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="{Binding IsWiping, Converter={StaticResource BoolToVis}}" />
                <!-- Afterwards: what happened to each drive and how long it took. -->
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WipeTime}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel x:Name="WipeColumn" MaxWidth="1100" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Modes}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="WipeMode" Style="{StaticResource Segment}" Content="{Binding Label}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="Wipe" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Free Space Only: one drive letter. -->
                        <StackPanel Visibility="{Binding EntireDrive, Converter={StaticResource NotVis}}">
                            <TextBlock Text="Drive" Style="{StaticResource SettingTitle}" Margin="0,18,0,6" />
                            <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Width="360" HorizontalAlignment="Left"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Display, Mode=OneWay}" />
                                            <Run Text="{Binding Format, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                            <Run Text="·" Foreground="{DynamicResource Muted}" />
                                            <Run Text="{Binding KindName, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Entire Drive: every attached disk, tick the ones to erase. -->
                        <StackPanel Visibility="{Binding EntireDrive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Drives" Style="{StaticResource SettingTitle}" Margin="0,18,0,6" />
                            <DataGrid tc:Placeholder.Text="Drives that can be wiped show here. Click Refresh to look again." ItemsSource="{Binding Disks}" MaxHeight="320" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                                      IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanWipe}"
                                                          HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Drive" Width="3*" SortMemberPath="Disk.Number">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Disk.Name}" ToolTip="{Binding Disk.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Type" Width="110" SortMemberPath="Disk.KindName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Disk.KindName}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Disk.Size" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Letters" Binding="{Binding Disk.Drives}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="130" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Status" Width="2*" SortMemberPath="Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding ListNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding EntireDrive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Wipe Type" Style="{StaticResource SettingTitle}" Margin="0,18,0,6" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding LevelChoices}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="WipeLevel" Style="{StaticResource Segment}" Content="{Binding Label}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Security" Style="{StaticResource SettingTitle}" Margin="0,18,0,6"
                                   Visibility="{Binding ShowSecurity, Converter={StaticResource BoolToVis}}" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left"
                                Visibility="{Binding ShowSecurity, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding MethodChoices}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="WipeMethod" Style="{StaticResource Segment}" Content="{Binding Label}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="{Binding MethodHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <DockPanel Margin="0,16,0,0" Visibility="{Binding ShowVerify, Converter={StaticResource BoolToVis}}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Verify}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" AutomationProperties.Name="Verify the Last Pass" />
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Verify the Last Pass" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Reads every byte back after the last pass to prove it landed. Adds one more pass of time."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <!-- After wiping: leave it uninitialized like a new drive, or format it. -->
                        <StackPanel Visibility="{Binding EntireDrive, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,16,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LeaveUninitialized}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" AutomationProperties.Name="Leave It Uninitialized Like a New Drive" />
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Leave It Uninitialized Like a New Drive" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Every wipe removes all partitions, the MBR or GPT and the boot sectors. On: nothing is put back, so Windows asks to initialize the drive, just like one fresh from the factory. Off: it's set up with the format below."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <!-- Which format is recommended for the ticked drive's type, and why (Ted). -->
                            <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="{DynamicResource Radius}" BorderThickness="1"
                                    Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource Accent}" IsEnabled="{Binding FormatEnabled}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Use Recommended" Command="{Binding UseRecommendedCommand}" VerticalAlignment="Center"
                                            Margin="14,0,0,0" Visibility="{Binding IsCustomFormat, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}"
                                               VerticalAlignment="Top" Margin="0,1,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecommendTitle}" Style="{StaticResource SettingTitle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RecommendText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding FormatEnabled}">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <StackPanel Margin="0,0,28,8">
                                    <TextBlock Text="Partition Style" Style="{StaticResource SettingTitle}" Margin="0,0,0,6" />
                                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding StyleChoices}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="PartitionStyle" Style="{StaticResource Segment}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Recommended" FontSize="11" FontWeight="Normal" />
                                                    </Border>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,8">
                                    <TextBlock Text="File System" Style="{StaticResource SettingTitle}" Margin="0,0,0,6" />
                                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding FileSystemChoices}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="FileSystem" Style="{StaticResource Segment}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         AutomationProperties.Name="{Binding Label}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Recommended" FontSize="11" FontWeight="Normal" />
                                                    </Border>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Drive Name" Style="{StaticResource SettingTitle}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="32"
                                             IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel IsEnabled="{Binding FormatEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="GPT suits drives over 2 TB and modern PCs; MBR suits older PCs and devices. NTFS for Windows, exFAT to share with Macs, TVs and cameras, FAT32 for old devices (drives up to 32 GB)."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius}" Padding="12,10" Margin="0,18,0,0">
                            <TextBlock Text="{Binding DriveNote}" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Progress and Stop are in the wipe's own card at the top of the page. -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Command="{Binding WipeCommand}" Style="{StaticResource AccentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Wipe" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- How each drive type is erased, A to Z. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="How Each Drive Type Is Erased" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,12">
                                <TextBlock Text="Flash Drive" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="USB sticks and memory cards are overwritten with the passes you choose. They can't run a firmware erase from Windows, so for top-secret data, destroy the stick." />
                            <Border Grid.Row="1" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,12">
                                <TextBlock Text="Hard Drive" />
                            </Border>
                            <TextBlock Grid.Row="1" TextWrapping="Wrap" Grid.Column="1" Margin="0,0,0,12"
                                       Text="Every sector is overwritten with the passes you choose (DoD 5220.22-M), then the last pass is read back and checked." />
                            <Border Grid.Row="2" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,12">
                                <TextBlock Text="NVMe SSD" />
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="The drive's own firmware erase (NIST SP 800-88 Purge): a crypto erase throws away the key every cell was written with, then a block erase if needed. Takes seconds and reaches the spare cells overwriting can't." />
                            <Border Grid.Row="3" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,0">
                                <TextBlock Text="SSD" />
                            </Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"
                                       Text="The firmware erase too, when the drive offers it to Windows. If it doesn't, the drive is overwritten with random data and then trimmed, the most Windows can do for it." />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
