<UserControl x:Class="KodiakCleaner.App.Views.WiperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Drive Wiper" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Overwrite free space so deleted files can't be recovered, or securely erase a whole drive you're giving away." />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" MaxWidth="840" HorizontalAlignment="Left">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Wipe" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource SegmentHost}" Margin="0,10,0,0" HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding Modes}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="WipeMode" Style="{StaticResource Segment}" Content="{Binding Label}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="Drive" Margin="0,18,0,6" />
                        <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Width="320" HorizontalAlignment="Left"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Display, Mode=OneWay}" />
                                        <Run Text="{Binding Format, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Security" Margin="0,18,0,6" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding PassChoices}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="WipePasses" Style="{StaticResource Segment}" Content="{Binding Label}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="One pass is enough for modern drives. More passes take proportionally longer."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" />

                        <Border Background="{DynamicResource WarnBg}" CornerRadius="6" Padding="12,10" Margin="0,18,0,0">
                            <TextBlock Text="{Binding DriveNote}" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Command="{Binding WipeCommand}" Style="{StaticResource AccentButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Wipe" />
                                </StackPanel>
                            </Button>
                            <Button Content="Stop" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" x:Name="ProgressCard">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource Caption}"
                           Visibility="{Binding IsBusy, Converter={StaticResource NotVis}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
