<UserControl x:Class="KodiakCleaner.App.Views.SupporterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Perk" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius}" Padding="12,10" Margin="0,0,0,16"
                Visibility="{Binding IsTestKey, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{DynamicResource WarnText}" TextWrapping="Wrap"
                       Text="Test key in use: this build checks supporter codes with the test key, so real codes won't work. Release builds refuse to build until Ted's own key is added." />
        </Border>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Kodiak Cleaner is free, with every feature included. If it has helped you, a one-time thank-you on Ko-fi keeps it going, and unlocks a few small extras as a thank-you back." />

        <!-- Free and Supporter side by side -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Free" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Free Forever" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <DockPanel Style="{StaticResource Perk}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="Every cleaning tool and feature. Nothing essential is locked." TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Perk}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="Honey theme in light and dark." TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Perk}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="No ads, no tracking, no nagging." TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Visibility="{Binding IsSupporter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Your Plan" />
                        </Border>
                        <TextBlock Text="Supporter" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="One-time thank-you. Yours to keep." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <DockPanel Style="{StaticResource Perk}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="Everything in Free." TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Perk}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="Classic and Glacier themes: crisp white and blue, and calm blue-grey, in light and dark." TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Perk}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="Supporter Badge next to the name (you can hide it)." TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Perk}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,2,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="The Support Kodiak Cleaner link disappears." TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Not a supporter yet -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsFree, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Become a Supporter" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Support Kodiak Cleaner on Ko-fi. You'll receive a supporter code by email to enter below." TextWrapping="Wrap" Margin="0,6,0,0" />
                <Button Command="{Binding KoFiCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Support on Ko-fi" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Already a supporter -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsSupporter, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding Thanks}" Style="{StaticResource SectionTitle}" />
                <DockPanel Margin="0,14,0,0">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBadge}" />
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Show Supporter Badge" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Shows a small Supporter badge under the Kodiak Cleaner name in the sidebar." Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Supporter code -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Supporter Code" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Checked on this PC only. Nothing is sent anywhere." Style="{StaticResource Caption}" Margin="0,2,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding ApplyCodeCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. eyJpZCI6IjNmOWMx...Q2xvdWQ" FontFamily="Consolas" />
                </DockPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <Button Content="Remove Code from This PC" Command="{Binding RemoveCodeCommand}" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="-8,4,0,0" Visibility="{Binding HasCode, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
