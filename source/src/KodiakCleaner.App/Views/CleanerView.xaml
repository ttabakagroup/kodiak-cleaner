<UserControl x:Class="KodiakCleaner.App.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tc="clr-namespace:KodiakCleaner.App.Views"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Cleaner" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Remove temporary files, caches and other junk that Windows and your browsers leave behind." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Summary + actions -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Command="{Binding AnalyzeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Analyze" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CleanCommand}" Style="{StaticResource AccentButton}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Run Cleaner" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                        <TextBlock Text="{Binding TotalLabel}" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Bottom" Margin="10,0,0,6" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,16,0" />
                    <ProgressBar IsIndeterminate="True" Margin="0,10,16,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <tc:TaskClock Margin="0,6,16,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shown after an analysis only when Advanced Cleaning would free a lot (or a fair amount on a nearly full drive). -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AccentTint}" CornerRadius="{DynamicResource Radius}" Padding="14,10" Margin="0,0,0,16"
                Visibility="{Binding HasAdvancedHint, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Show Advanced Cleaning" Command="{Binding ToggleAdvancedCommand}" Margin="12,0,0,0" />
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding AdvancedHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Search, and the Advanced Cleaning button that shows the deeper temporary-file items. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Command="{Binding ResetCommand}" Margin="12,0,0,0"
                    ToolTip="Tick only the basic items Kodiak Cleaner starts with.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Reset to Default" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding ToggleAdvancedCommand}" Margin="12,0,0,0"
                    ToolTip="More temporary files, old logs and caches. They are never ticked until you choose them.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AdvancedButtonText}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding ScheduleCommand}" Margin="12,0,0,0"
                    ToolTip="Clean chosen items on set days, using Windows Task Scheduler.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Schedule" />
                </StackPanel>
            </Button>
            <local:SearchBox Text="{Binding Filter}" Placeholder="Search items, browsers and descriptions" />
        </DockPanel>

        <!-- Sort By (Ted, 0.8.21): Default (0.8.23) is selected out of the box; the choice is remembered. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Sort By" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,12,0" />
            <Border Style="{StaticResource SegmentHost}">
                <ItemsControl ItemsSource="{Binding Sorts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="CleanerSort" Style="{StaticResource Segment}" Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Command="{Binding PickCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <!-- Grouped lists aren't virtualized by default, which built every row at startup; these keep only the visible rows. -->
            <DataGrid tc:Placeholder.Text="No cleaning items match your search. Clear the search to see them all." ItemsSource="{Binding View}" IsSynchronizedWithCurrentItem="False" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <!-- The group's own program icon (read from the installed browser), or a plain placeholder. -->
                                <StackPanel Orientation="Horizontal" Margin="10,14,0,4">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Items[0].GroupIcon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Items[0].GroupGlyph}" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding Items[0].NoGroupIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                      IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Item" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap"
                                               Margin="0,2,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last Cleaned" Binding="{Binding LastCleaned}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
