<UserControl x:Class="KodiakCleaner.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <CollectionViewSource x:Key="Grouped" Source="{Binding Facts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="System Information" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="A quick look at this PC: Windows, processor, memory and drives. Read-only, and nothing leaves your PC." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding CopyCommand}" Style="{StaticResource AccentButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Copy to Clipboard" />
                </StackPanel>
            </Button>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}" Focusable="False">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="13" Width="170" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
