<UserControl x:Class="KodiakCleaner.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tc="clr-namespace:KodiakCleaner.App.Views">
    <UserControl.Resources>
        <!-- Two levels: the section (Windows, Storage...), then the thing a row belongs to (Disk 0, Slot DIMM1...) when there are several. -->
        <CollectionViewSource x:Key="Grouped" Source="{Binding CurrentFacts}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
                <PropertyGroupDescription PropertyName="Item" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="System Information" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="A look at this PC. Summary covers the basics; Advanced adds serial numbers, network addresses, memory, BIOS and more. Read-only, and nothing leaves your PC." />
        </StackPanel>

        <!-- Summary | Advanced, with Copy to Clipboard and Refresh on the right. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="SystemInfoView" Style="{StaticResource Segment}" Content="Summary" IsChecked="{Binding ShowSummary, Mode=TwoWay}" />
                    <RadioButton GroupName="SystemInfoView" Style="{StaticResource Segment}" Content="Advanced" IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding CopyCommand}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Copy to Clipboard" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Export Report (Ted, 0.8.46): pick Text, HTML or CSV; saved to the Reports folder beside Backups and Logs. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ExportCommand}" Style="{StaticResource AccentButton}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Export Report" />
                    </StackPanel>
                </Button>
                <ComboBox DockPanel.Dock="Right" Width="210" VerticalAlignment="Center" ItemsSource="{Binding ReportFormats}"
                          SelectedValuePath="Format" SelectedValue="{Binding ReportFormat}" AutomationProperties.Name="Report Format" />
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Export a Report" Style="{StaticResource SettingTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Saves Summary and Advanced together in the Reports folder. Reports include serial numbers and network addresses, so share them only with people you trust." />
                    <!-- Link buttons have 8px padding; the negative margin lines their text up with the caption above. -->
                    <StackPanel Orientation="Horizontal" Margin="-8,4,0,0">
                        <Button Content="Open Reports Folder" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource LinkButton}" Margin="0" />
                        <Button Content="Show Report" Command="{Binding OpenReportCommand}" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                Visibility="{Binding HasReport, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
            <!-- While reading (0.8.51, Ted): progress and Cancel. Reading goes on in the background, so other pages stay usable. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24"
                        Visibility="{Binding ShowLoading, Converter={StaticResource Visible}}">
                <TextBlock Text="Reading System Information" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                <ProgressBar Width="320" Height="6" Margin="0,14,0,0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate, Mode=OneWay}" />
                             <tc:TaskClock Margin="0,8,0,0" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="This can take a little while on some PCs. You can use other pages meanwhile; it keeps reading and is ready when you come back." />
                <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
            <!-- After Cancel, with nothing read yet: a plain screen. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24"
                        Visibility="{Binding ShowStopped, Converter={StaticResource Visible}}">
                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" />
                <TextBlock Text="Reading Stopped" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Nothing more is being read. Click Refresh to read it again." />
                <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowList, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}" Focusable="False">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="13" Width="200" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
