<UserControl x:Class="KodiakCleaner.App.Views.ScheduledTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Scheduled Tasks" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Programs Windows runs on a schedule, like updaters that check in the background. Turning one off can be undone any time. A task you delete is backed up first, and Restore puts it back." />
        </StackPanel>

        <!-- Batch actions, like Startup: tick tasks (or the header box for all), then turn them on or off, back them up or delete them
             together. Delete always backs up to Backups\Scheduled Tasks first; Restore lists those backups (Ted, 2026-10-23). -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding DisableSelectedCommand}" Style="{StaticResource AccentButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Disable Selected" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding EnableSelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Enable Selected" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding BackUpSelectedCommand}" ToolTip="Saves the ticked tasks to Backups\Scheduled Tasks without changing them.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Back Up Selected" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding DeleteSelectedCommand}" ToolTip="Backs up the ticked tasks, then deletes them.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Delete Selected" />
                </StackPanel>
            </Button>
        </DockPanel>
        <!-- Second row so Restore and the switch aren't pushed off the edge in a normal-size window. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="False">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding RestoreCommand}" ToolTip="Puts back tasks from Backups\Scheduled Tasks.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Restore" />
                </StackPanel>
            </Button>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Show Windows Tasks" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowWindowsTasks}" AutomationProperties.Name="Show Windows Tasks" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="8,4,8,8" />
                <DataGrid views:Placeholder.Text="Scheduled tasks show here. Show Windows Tasks lists Windows' own too." RowStyle="{StaticResource DetailsRow}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                          SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Enable" Command="{Binding EnableRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Disable" Command="{Binding DisableRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Back Up" Command="{Binding BackUpRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete" Command="{Binding DeleteRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Open File Location" Command="{Binding OpenLocationCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                        <!-- The program each task runs, with its icon; click it to see the file in File Explorer (Ted, 0.8.65). -->
                        <DataGridTemplateColumn Header="Program" Width="2*" SortMemberPath="Program" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="&#xE7C4;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Muted}" Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <Button Style="{StaticResource LinkButton}" Content="{Binding Program}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ShowProgramCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding ProgramPath}"
                                                Visibility="{Binding HasProgram, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Program}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding NoProgram, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.5*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Next Run" Binding="{Binding NextRun}" Width="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="Last Run" Binding="{Binding LastRun}" Width="140" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="On" Width="80" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
