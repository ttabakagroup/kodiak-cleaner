<UserControl x:Class="KodiakCleaner.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <!-- Programs History (Ted, 0.8.22): beside the title, so the toolbar keeps room for the search box. -->
            <Button DockPanel.Dock="Right" Command="{Binding HistoryCommand}" VerticalAlignment="Top" Margin="12,4,0,0"
                    ToolTip="Everything removed or changed here: uninstalls, deleted entries, renames and leftovers. Put them back from here.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="History" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Programs" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh" Padding="14,0" MinWidth="0">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
                </Button>
                <Button Command="{Binding RepairCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Repair" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RenameCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Rename" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Delete Entry" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding UninstallCommand}" Style="{StaticResource AccentButton}" Margin="0"
                        ToolTip="Uninstalls every ticked program, one at a time, or the highlighted programs when none are ticked. Ctrl-click or Shift-click to highlight several.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Uninstall" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <local:SearchBox Text="{Binding Filter}" Placeholder="Search by name, publisher or product code" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <DataGrid local:Placeholder.Text="Installed programs show here. If you searched, none match." RowStyle="{StaticResource DetailsRow}" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" IsReadOnly="True" IsSynchronizedWithCurrentItem="False"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged">
                <!-- Right-click a program for the same actions as the buttons above. Ctrl-click and Shift-click highlight several programs
                     (Ted, 0.8.49): Uninstall and Delete Entry act on all of them; Repair and Rename need just one. -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Uninstall" Command="{Binding UninstallSelectedCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Repair" Command="{Binding RepairCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Rename" Command="{Binding RenameCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete Entry" Command="{Binding DeleteCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Copy Product Code" Command="{Binding CopyProductCodeCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy Uninstall Command" Command="{Binding CopyUninstallCommandCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                      IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Name" Width="3*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="2*" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" MinWidth="76" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate, StringFormat=d}" Width="100" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="90" />
                    <DataGridTextColumn Header="For" Binding="{Binding Scope}" Width="90" />
                    <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="2.6*" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding ProductCode}" />
                                <Setter Property="ToolTipService.IsEnabled" Value="{Binding HasProductCode}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
