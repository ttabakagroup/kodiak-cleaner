<UserControl x:Class="KodiakCleaner.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Defrag and TRIM" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Keep drives quick. Hard drives are defragmented and SSDs are trimmed, picked for each drive automatically, using Windows' own optimizer." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding AnalyzeCommand}" ToolTip="Checks how fragmented the ticked hard drives are">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Analyze" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding OptimizeCommand}" Style="{StaticResource AccentButton}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Optimize Selected" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="What Each Drive Gets" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,10">
                        <TextBlock Text="Defragment" />
                    </Border>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Hard drives: puts each file's scattered pieces back together so the disk head moves less. Analyze shows how fragmented a drive is first." />
                    <Border Grid.Row="1" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,10">
                        <TextBlock Text="Not Needed" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="USB sticks and memory cards: neither step helps them, so they're left alone." />
                    <Border Grid.Row="2" Style="{StaticResource Chip}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,14,0">
                        <TextBlock Text="TRIM" />
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"
                               Text="SSDs and NVMe drives: tells the drive which blocks are free so it keeps writing at full speed. SSDs are never defragmented; it only wears them." />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Drives}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOptimize}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Drive" Binding="{Binding Drive.Display}" Width="2*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Type" Width="110" SortMemberPath="Drive.KindName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Drive.KindName}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File System" Binding="{Binding Drive.Format}" Width="100" IsReadOnly="True" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Drive.Size" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="70" IsReadOnly="True" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Drive.ActionName}" Width="110" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Status" Width="2*" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,8,0"
                                                     Visibility="{Binding Started, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
