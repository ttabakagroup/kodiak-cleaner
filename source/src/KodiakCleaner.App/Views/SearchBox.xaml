<UserControl x:Class="KodiakCleaner.App.Views.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- The search box used above tables: a magnifier, a hint while empty, and a fresh search on every click in. -->
    <Grid>
        <TextBox x:Name="Box" Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,8,7"
                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left" TextAlignment="Left"
                 AutomationProperties.Name="{Binding Placeholder, ElementName=Root, TargetNullValue=Search, FallbackValue=Search}"
                 PreviewMouseLeftButtonDown="Box_PreviewMouseDown" GotKeyboardFocus="Box_GotKeyboardFocus" />
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left"
                   Foreground="{DynamicResource Muted}" IsHitTestVisible="False" />
        <TextBlock Text="{Binding Placeholder, ElementName=Root}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource Muted}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Text, ElementName=Box}" Value="" />
                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=Box}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
