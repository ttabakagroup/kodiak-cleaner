<UserControl x:Class="KodiakCleaner.App.Views.BootTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tc="clr-namespace:KodiakCleaner.App.Views">
    <UserControl.Resources>
        <!-- A summary tile: a colored dot that matches its part of the timeline, a label and the time. -->
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Boot Timer" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Restart this PC and time how long it takes to be ready, then see which programs slow the start so you can turn them off." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding RestartCommand}" Style="{StaticResource AccentButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Restart and Time" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding CancelCommand}" Content="Cancel Timing"
                    Visibility="{Binding IsTiming, Converter={StaticResource BoolToVis}}" />
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Margin="0" ToolTip="Add Windows' own boot measurement to the report">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding ClearHistoryCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Clear Results" />
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Before the first timing: how it works. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding ShowIntro, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="How It Works" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentTint}" Margin="0,0,12,0">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Save your work, then press Restart and Time. Kodiak Cleaner restarts this PC." />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentTint}" Margin="0,0,12,0">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Sign in as usual. Kodiak Cleaner opens by itself and waits until the PC settles down." />
                    </DockPanel>
                    <DockPanel>
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentTint}" Margin="0,0,12,0">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="See how long the shutdown, Windows' start and your desktop took, and which programs slowed it. Turn off the ones you don't need at startup." />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="38,12,0,0"
                               Text="Everything is measured on this PC with Windows' own information. Running Kodiak Cleaner as administrator adds Windows' boot measurement and the drivers and services it found slow." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Waiting for the restart, or measuring after it. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsWaiting}" Value="False" />
                                <Condition Binding="{Binding IsMeasuring}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Timing This Start" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Progress}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}" />
                <tc:TaskClock Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- The report. -->
        <DockPanel Visibility="{Binding ShowReport, Converter={StaticResource BoolToVis}}">
            <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0" Background="{DynamicResource AccentTint}">
                    <StackPanel>
                        <TextBlock Text="Total Restart" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding Total}" Style="{StaticResource TileValue}" FontSize="30" />
                        <TextBlock Text="From the click to a settled desktop" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Primary}" />
                            <TextBlock Text="Restarting" Style="{StaticResource SettingTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Shutdown}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Closing programs and the PC's own startup screen" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Accent}" />
                            <TextBlock Text="Windows Starting" Style="{StaticResource SettingTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding WindowsStart}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Until you signed in, including the sign-in screen" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Dot}" Fill="{DynamicResource Success}" />
                            <TextBlock Text="Desktop Settling" Style="{StaticResource SettingTitle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DesktopLoad}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Startup programs loading after sign-in" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Timeline" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <!-- One bar, split in proportion to how long each part took. -->
                        <Border CornerRadius="{DynamicResource Radius}" ClipToBounds="True" Height="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ShutdownWidth}" />
                                    <ColumnDefinition Width="{Binding WindowsWidth}" />
                                    <ColumnDefinition Width="{Binding DesktopWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Primary}" ToolTip="{Binding Shutdown}" />
                                <Border Grid.Column="1" Background="{DynamicResource Accent}" ToolTip="{Binding WindowsStart}" />
                                <Border Grid.Column="2" Background="{DynamicResource Success}" ToolTip="{Binding DesktopLoad}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Measured}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding WindowsLine}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <!-- The last ten timings, so a change (a program turned off, a new driver) shows up at a glance. -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="12,0,0,0"
                        Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Recent Restarts" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="40" ToolTip="{Binding Tip}">
                                        <Grid Height="90">
                                            <Border Width="18" Height="{Binding Height}" VerticalAlignment="Bottom" Background="{DynamicResource Accent}"
                                                    CornerRadius="3,3,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Show in Startup" Command="{Binding ShowInStartupCommand}" />
                            <Button Command="{Binding DisableCommand}" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Turn Off at Startup" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="What Slowed the Start" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid RowStyle="{StaticResource DetailsRow}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown" SelectionChanged="Grid_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show in Startup" Command="{Binding ShowInStartupCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Turn Off at Startup" Command="{Binding DisableCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="180" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource Muted}"
                                                           Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="140" />
                            <DataGridTemplateColumn Header="Impact" Width="80" SortMemberPath="ImpactLevel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Impact}" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Impact}" Value="High">
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Impact}" Value="Medium">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="*" MinWidth="130" SortMemberPath="Item.StartedAfterSignIn" />
                            <DataGridTextColumn Header="Processor Time" Binding="{Binding Processor}" Width="110" SortMemberPath="Item.CpuMs" />
                            <DataGridTextColumn Header="Disk Use" Binding="{Binding Disk}" Width="90" SortMemberPath="Item.DiskBytes" />
                            <DataGridTextColumn Header="Windows Delay" Binding="{Binding Delay}" Width="110" SortMemberPath="Item.DelayMs" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
