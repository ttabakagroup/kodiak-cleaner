<UserControl x:Class="KodiakCleaner.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One setting: title + description on the left, control on the right (as on the Settings page) -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="DimWhenOff" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="System Restore" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Create and remove Windows restore points, and manage Windows 11's Point-in-Time Restore snapshots." />
            </StackPanel>
        </DockPanel>

        <!-- System Restore | Point-in-Time Restore -->
        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="RestoreKind" Style="{StaticResource Segment}" Content="System Restore" IsChecked="{Binding ShowSystemRestore}" />
                <RadioButton GroupName="RestoreKind" Style="{StaticResource Segment}" Content="Point-in-Time Restore" IsChecked="{Binding ShowPitr}" />
            </StackPanel>
        </Border>

        <Grid>
            <!-- System Restore -->
            <DockPanel Visibility="{Binding ShowSystemRestore, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                    <Button Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CreateCommand}" Style="{StaticResource AccentButton}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Create Restore Point" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open System Restore" Command="{Binding OpenSystemRestoreCommand}" />
                            <Button Content="Configure…" Command="{Binding OpenProtectionCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Make one right before a big install: Windows keeps these until it needs the space, much longer than Point-in-Time Restore's 72 hours." />
                            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="8">
                    <DataGrid ItemsSource="{Binding Points}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=g}" Width="180" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- Point-in-Time Restore (Windows 11 24H2 and later) -->
            <DockPanel DataContext="{Binding Pitr}"
                       Visibility="{Binding DataContext.ShowPitr, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                    <Button Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RecoveryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Restart to Recovery" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SnapshotCommand}" Style="{StaticResource AccentButton}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Snapshot Now" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,12,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanChange}"
                                          AutomationProperties.Name="Point-in-Time Restore" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Point-in-Time Restore" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding SetByOrganization, Converter={StaticResource BoolToVis}}"
                                           Text="Your organization manages these settings, so they can't be changed here." />
                                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Settings rows A to Z -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel Style="{StaticResource DimWhenOff}" IsEnabled="{Binding CanChange}">
                        <TextBlock Text="Snapshot Settings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="The same choices as Windows Settings, open on every edition. Windows puts them back to its defaults after a feature update." />
                        <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Retentions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Retention}" MinWidth="160" VerticalAlignment="Center"
                                      AutomationProperties.Name="Keep Snapshots For" />
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Keep Snapshots For" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Windows deletes a snapshot once it's this old. 72 hours is the longest Windows allows." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Spaces}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Space}" MinWidth="160" VerticalAlignment="Center"
                                      AutomationProperties.Name="Maximum Space" />
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Maximum Space" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="The most room all snapshots may take on the system drive. Nothing is set aside until it's used; the oldest snapshots go first when it fills up." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource SettingRow}">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Frequencies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Frequency}" MinWidth="160" VerticalAlignment="Center"
                                      AutomationProperties.Name="Take a Snapshot Every" />
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Take a Snapshot Every" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="How often Windows takes one on its own, when the PC is idle." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="8" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                    <DataGrid ItemsSource="{Binding Snapshots}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding Created, StringFormat=g, TargetNullValue=Unknown}" Width="180" />
                            <DataGridTextColumn Header="Kept Until" Binding="{Binding KeptUntil, StringFormat=g, TargetNullValue=Unknown}" Width="180" />
                            <DataGridTextColumn Header="Snapshot ID" Binding="{Binding Id, StringFormat={}{{{0}}}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
