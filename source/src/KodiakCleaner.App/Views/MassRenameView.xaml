<UserControl x:Class="KodiakCleaner.App.Views.MassRenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KodiakCleaner.App.Views"
             xmlns:tc="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Mass Rename" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Rename a set of files in a folder by a pattern. Every new name is shown before anything changes, and the last rename can be undone." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Choose Folder…" Command="{Binding BrowseCommand}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding LoadCommand}" Style="{StaticResource AccentButton}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Load Files" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Tag="Folder with the files to rename" />
        </DockPanel>

        <!-- The rules, in the order they're applied. -->
        <!-- Drag the grip between the rules and the preview to give either more room (Ted, 0.8.99). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="560" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Style="{StaticResource PaneColumns}" views:PaneSplitter.Remember="massrename" />

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                    <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                        <TextBlock Text="Files" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Only Files Matching" Style="{StaticResource SettingTitle}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Every file, or *.jpg; *.png" />
                        <TextBlock Text="Hidden and system files are never loaded. Select Load Files again after changing these."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeSubfolders}"
                                      AutomationProperties.Name="Include Subfolders" />
                            <TextBlock Text="Include Subfolders" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="New Name" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <TextBlock Text="Pattern" Style="{StaticResource SettingTitle}" Margin="0,8,0,4" />
                        <TextBox x:Name="PatternBox" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Tag="{}{name}"
                                 FontFamily="Consolas" ToolTip="{Binding TokenHelp}" />
                        <TextBlock Text="Select a part to add it where the cursor is:" Style="{StaticResource Caption}" Margin="0,6,0,2" />
                        <!-- A to Z. -->
                        <WrapPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Date Created" Tag="{}{created}" Click="InsertToken" Margin="0,0,12,4" />
                            <Button Style="{StaticResource LinkButton}" Content="Date Modified" Tag="{}{modified}" Click="InsertToken" Margin="0,0,12,4" />
                            <Button Style="{StaticResource LinkButton}" Content="Date Taken" Tag="{}{taken}" Click="InsertToken" Margin="0,0,12,4" />
                            <Button Style="{StaticResource LinkButton}" Content="Extension" Tag="{}{ext}" Click="InsertToken" Margin="0,0,12,4" />
                            <Button Style="{StaticResource LinkButton}" Content="Folder Name" Tag="{}{folder}" Click="InsertToken" Margin="0,0,12,4" />
                            <Button Style="{StaticResource LinkButton}" Content="Name" Tag="{}{name}" Click="InsertToken" Margin="0,0,12,4" />
                            <Button Style="{StaticResource LinkButton}" Content="Number" Tag="{}{num}" Click="InsertToken" Margin="0,0,12,4" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="{}{name:1-5} keeps characters 1 to 5, {num:3} pads to 3 digits, {modified:yyyy-MM-dd HH.mm} picks the date format. Point at the pattern for every part." />
                        <TextBlock Text="Examples" Style="{StaticResource SettingTitle}" Margin="0,10,0,2" />
                        <ItemsControl ItemsSource="{Binding Examples}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding Key}" ToolTip="{Binding Value}" Margin="0,0,12,4"
                                            Command="{Binding DataContext.ExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Numbering" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Digits" Style="{StaticResource SettingTitle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Digits, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Start At" Style="{StaticResource SettingTitle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Step" Style="{StaticResource SettingTitle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Number In Order Of" Style="{StaticResource SettingTitle}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding OrderChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Order}" />
                        <TextBlock Text="Only ticked files are numbered." Style="{StaticResource Caption}" Margin="0,4,0,0" />

                        <TextBlock Text="Find and Replace" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <TextBlock Text="Find" Style="{StaticResource SettingTitle}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" Tag="Text to find in the new name" />
                        <TextBlock Text="Replace With" Style="{StaticResource SettingTitle}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" Tag="Leave empty to remove it" />
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MatchCase}" AutomationProperties.Name="Match Case" />
                            <TextBlock Text="Match Case" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UseRegex}" AutomationProperties.Name="Regular Expression" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Regular Expression" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="For advanced patterns. $1 in Replace With puts back the first group in brackets."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Tidy Up" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <TextBlock Text="Extension" Style="{StaticResource SettingTitle}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding ExtensionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Extension}" />
                        <TextBox Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}" Tag="New extension, like jpg" Margin="0,6,0,0"
                                 Visibility="{Binding ChangingExtension, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Letter Case" Style="{StaticResource SettingTitle}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding CaseChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Case}" />
                        <DockPanel Margin="0,10,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TidySpaces}" AutomationProperties.Name="Tidy Spaces" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Tidy Spaces" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Removes spaces at the start and end, and doubled spaces." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <Button Content="Reset Rules" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <tc:TaskClock Margin="0,6,0,0" />
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="8,8,8,4">
                        <Button DockPanel.Dock="Right" Command="{Binding RenameCommand}" Style="{StaticResource AccentButton}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AC;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Rename" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding UndoCommand}" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Undo Last Rename" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show in Folder" Command="{Binding ShowRowCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Tick" Command="{Binding CheckRowsCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Untick" Command="{Binding UncheckRowsCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                              IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Current Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn x:Name="SubfolderColumn" Header="Subfolder" Binding="{Binding Subfolder}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Status" Width="1.4*" SortMemberPath="Status" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource WarnText}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
