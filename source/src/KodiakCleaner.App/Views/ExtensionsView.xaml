<UserControl x:Class="KodiakCleaner.App.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Browser Extensions" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Show Folder" Command="{Binding ShowFolderCommand}" />
                <Button Command="{Binding RefreshCommand}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <local:SearchBox Text="{Binding Filter}" Placeholder="Search by name or browser" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,10,0,0"
                   Text="Kodiak Cleaner only reads this list. To remove an extension, open the address under Manage At in that browser, so your browser's sync stays right." />

        <Border Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" IsReadOnly="True" IsSynchronizedWithCurrentItem="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="3*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Browser" Width="1.3*" SortMemberPath="Browser">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding BrowserIcon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding NoBrowserIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Browser}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                    <DataGridTextColumn Header="Manage At" Binding="{Binding ManageAt}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
