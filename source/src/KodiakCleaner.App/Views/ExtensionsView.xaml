<UserControl x:Class="KodiakCleaner.App.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Browser Extensions" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Show Folder" Command="{Binding ShowFolderCommand}" />
                <Button Command="{Binding RefreshCommand}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <local:SearchBox Text="{Binding Filter}" Placeholder="Search by name or browser" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,10,0,0"
                   Text="Right-click an extension to turn it on or off, or remove it; Ctrl-click and Shift-click pick several. Chrome, Edge and Brave are changed through their own extension policies, so they say they are managed by your organization until nothing needs it (this needs Restart as Administrator). Firefox add-ons can be removed while Firefox is closed; turn them off in Firefox itself." />

        <Border Style="{StaticResource Card}" Padding="8">
            <DataGrid local:Placeholder.Text="Extensions from your browsers show here. If you searched, none match; click Refresh to look again." RowStyle="{StaticResource DetailsRow}" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                      IsSynchronizedWithCurrentItem="False" SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                <!-- Right-click to turn extensions on or off or remove them (Ted, 0.8.65); the menu acts on every highlighted row. -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Turn On" Command="{Binding TurnOnCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Turn Off" Command="{Binding TurnOffCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Show Folder" Command="{Binding ShowFolderCommand}">
                            <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="160" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Browser" Width="1.4*" MinWidth="150" SortMemberPath="Browser">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding BrowserIcon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Visibility="{Binding NoBrowserIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Browser}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" MinWidth="110" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                    <DataGridTextColumn Header="Manage At" Binding="{Binding ManageAt}" Width="*" MinWidth="120" />
                    <DataGridTemplateColumn Header="On" Width="80" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToggleTip}" ToolTipService.ShowOnDisabled="True"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
