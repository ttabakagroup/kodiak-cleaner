<UserControl x:Class="KodiakCleaner.App.Views.HashCheckerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KodiakCleaner.App.Views"
             AllowDrop="True" PreviewDragOver="Page_DragOver" PreviewDrop="Page_Drop">
    <DockPanel Background="Transparent">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Command="{Binding AddFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Add Folder…" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddFilesCommand}" Style="{StaticResource AccentButton}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Add Files…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Hash Checker" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Work out a file's MD5, SHA-1, SHA-256, SHA-384 and SHA-512, and check files against a list of hashes. Drop files here, or a .sha256 or .md5 list." />
            </StackPanel>
        </DockPanel>

        <!-- The expected hashes: pasted or loaded. Every file is checked against them as they change. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding ClearListCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadListCommand}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Load List…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Expected Hashes" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ListSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBox Text="{Binding ExpectedText, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12" MinHeight="64" MaxHeight="110" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Tag="Paste one hash, or lines such as: hash  file name" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentHost}" Margin="0,0,12,0" ToolTip="Which hash the table shows">
                <ItemsControl ItemsSource="{Binding ShownKinds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="HashKind" Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <local:SearchBox Text="{Binding Filter}" Placeholder="Search by name or hash (Ctrl+F)" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="8,4,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <Button Command="{Binding ComputeCommand}" Content="Compute Hashes" Visibility="{Binding ShowCompute, Converter={StaticResource BoolToVis}}"
                                ToolTip="Works out the hashes of files that are still waiting (after Cancel)." />
                        <Button Command="{Binding SaveCommand}"
                                ToolTip="Saves the shown kind of hash for the ticked files (or all of them) as a checksum file, as sha256sum writes it.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Save Checksum File…" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveCommand}" Margin="0"
                                ToolTip="Takes the ticked files (or the highlighted ones) off this list. The files themselves aren't touched.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Remove from List" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,8">
                    <TextBlock Text="{Binding SearchSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <local:TaskClock Margin="0,6,0,0" />
                </StackPanel>
                <!-- Tick boxes, Ctrl-click, Shift-click and drag to pick several (ListSelect, from the shared style), and a right-click menu. -->
                <DataGrid ItemsSource="{Binding View}" RowDetailsVisibilityMode="Collapsed" AreRowDetailsFrozen="True" IsReadOnly="True" IsSynchronizedWithCurrentItem="False"
                          SelectionChanged="Grid_SelectionChanged" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <!-- A to Z (Ted's rule): the copy items, then the file items. -->
                            <MenuItem Header="Copy All Hashes" Command="{Binding CopyAllCommand}" />
                            <MenuItem Header="Copy Another Hash">
                                <MenuItem Header="MD5" Command="{Binding CopyKindCommand}" CommandParameter="Md5" />
                                <MenuItem Header="SHA-1" Command="{Binding CopyKindCommand}" CommandParameter="Sha1" />
                                <MenuItem Header="SHA-256" Command="{Binding CopyKindCommand}" CommandParameter="Sha256" />
                                <MenuItem Header="SHA-384" Command="{Binding CopyKindCommand}" CommandParameter="Sha384" />
                                <MenuItem Header="SHA-512" Command="{Binding CopyKindCommand}" CommandParameter="Sha512" />
                            </MenuItem>
                            <MenuItem Header="{Binding ShownKindName}" HeaderStringFormat="Copy {0}" Command="{Binding CopyShownCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Remove from List" Command="{Binding RemoveRowCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Show in Folder" Command="{Binding ShowInFolderCommand}">
                                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <!-- The one highlighted file's five hashes in full, each with Copy, open right under its row. -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <!-- As wide as the table shows (not as wide as a SHA-512), so the Copy buttons stay in view; long hashes wrap. -->
                            <Border Padding="56,4,16,10" HorizontalAlignment="Left"
                                    Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="72" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" ToolTip="Copy" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.CopyOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" />
                                                </Button>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource Success}" VerticalAlignment="Center" ToolTip="Matches the list"
                                                           Visibility="{Binding IsMatch, Converter={StaticResource BoolToVis}}" />
                                                <TextBox Text="{Binding Hash, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"
                                                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,2" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding CheckDetails}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                          IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.5*" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="80" />
                        <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="3*" FontFamily="Consolas" />
                        <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0" ToolTip="{Binding StatusTip}">
                                        <TextBlock FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Text" Value="&#xE73E;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Text" Value="&#xE783;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
