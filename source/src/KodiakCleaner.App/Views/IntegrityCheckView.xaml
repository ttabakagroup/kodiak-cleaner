<UserControl x:Class="KodiakCleaner.App.Views.IntegrityCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tc="clr-namespace:KodiakCleaner.App.Views">
    <UserControl.Resources>
        <!-- The result chip: green for no problems or repaired, amber for worth a look, red for problems. -->
        <Style x:Key="ResultChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="good">
                    <Setter Property="Background" Value="{DynamicResource Success}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource WarnBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="bad">
                    <Setter Property="Background" Value="{DynamicResource DangerBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerFg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A check's heading row, summary and progress (DataContext: IntegrityCard). The glyph comes in as Tag. -->
        <DataTemplate x:Key="CardHead">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource ResultChip}">
                        <TextBlock Text="{Binding ResultName}" />
                    </Border>
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Style="{StaticResource Icon}"
                               FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="30,4,0,0" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="30,10,0,0" FontWeight="SemiBold"
                           Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding LastRun}" Style="{StaticResource Caption}" Margin="30,2,0,0"
                           Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVis}}" />
                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="30,8,0,0"
                             IsIndeterminate="{Binding HasPercent, Converter={StaticResource Not}}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <Border Margin="30,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <tc:TaskClock Owner="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="CardButtons" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="30,14,0,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Integrity Check" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Check Windows' own files, your drives and memory for damage, and repair what Windows can, using Windows' own tools." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <Button DockPanel.Dock="Left" Command="{Binding CheckEverythingCommand}" Style="{StaticResource AccentButton}"
                    ToolTip="Runs every check. Nothing is changed; repairs only run when you choose Repair.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Check Everything" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Content="Stop" Command="{Binding StopCommand}"
                    Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}" />
            <Button DockPanel.Dock="Right" Command="{Binding OpenReportsCommand}" Margin="0"
                    ToolTip="Every check and repair saves Windows' full messages here">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Open Reports Folder" />
                </StackPanel>
            </Button>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,0,0,12"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <!-- A repair waits for the next start. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16" Background="{DynamicResource AccentTint}"
                Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RestartCommand}" Style="{StaticResource AccentButton}" Margin="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Restart Now" />
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Restart to Finish" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="A repair runs the next time the PC restarts. Save your work, then restart now or whenever suits you."
                               TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <!-- Checks A to Z. -->

                <!-- Drive Error History -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <ContentControl Content="{Binding History}" ContentTemplate="{StaticResource CardHead}" Tag="&#xE81C;" Focusable="False" />
                        <DataGrid ItemsSource="{Binding Events}" Margin="30,12,0,0" MaxHeight="260" PreviewMouseWheel="Inner_PreviewMouseWheel"
                                  Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastText}" SortMemberPath="Last" Width="140" IsReadOnly="True" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Times" Binding="{Binding Count}" Width="70" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="What It Means" Width="*" SortMemberPath="Meaning">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Meaning}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Message}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Style="{StaticResource CardButtons}">
                            <Button Content="Check" Command="{Binding CheckHistoryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Drive File System -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <ContentControl Content="{Binding FileSystem}" ContentTemplate="{StaticResource CardHead}" Tag="&#xEDA2;" Focusable="False" />
                        <DataGrid tc:Placeholder.Text="Drives show here. Click Refresh to look again." ItemsSource="{Binding Drives}" Margin="30,12,0,0" MaxHeight="260" PreviewMouseWheel="Inner_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="48" CanUserResize="False" HeaderStyle="{StaticResource CheckColumnHeader}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsThreeState="False" ToolTip="Select All" HorizontalAlignment="Center"
                                                  IsChecked="{Binding DataContext.AllDrivesChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCheck}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Drive" Binding="{Binding Display}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Drive.KindName}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="File System" Binding="{Binding Drive.Format}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Drive.Size" Width="90" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Status" Width="2*" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ResultChip}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="30,14,0,0" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="Check" Command="{Binding CheckFileSystemCommand}" />
                            <Button DockPanel.Dock="Left" Content="Repair" Command="{Binding RepairFileSystemCommand}" />
                            <Button DockPanel.Dock="Left" Command="{Binding RefreshDrivesCommand}" ToolTip="Read the drive list again">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LookForBadSectors}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" AutomationProperties.Name="Look for Bad Sectors"
                                      ToolTip="Repair also reads every part of the drive and moves data off damaged spots. Can take hours on a large hard drive." />
                            <TextBlock DockPanel.Dock="Right" Text="Look for Bad Sectors" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Drive Health -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <ContentControl Content="{Binding DiskHealthCard}" ContentTemplate="{StaticResource CardHead}" Tag="&#xE95E;" Focusable="False" />
                        <DataGrid ItemsSource="{Binding Disks}" Margin="30,12,0,0" MaxHeight="260" PreviewMouseWheel="Inner_PreviewMouseWheel"
                                  Visibility="{Binding HasDisks, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Health" Width="130" SortMemberPath="ResultName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ResultChip}" HorizontalAlignment="Left" ToolTip="{Binding Note}">
                                                <TextBlock Text="{Binding ResultName}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Temperature" Binding="{Binding TemperatureText}" SortMemberPath="TemperatureC" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Wear" Binding="{Binding WearText}" SortMemberPath="WearPercent" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Errors" Binding="{Binding ErrorsText}" SortMemberPath="UncorrectedErrors" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Powered On" Binding="{Binding PowerOnText}" SortMemberPath="PowerOnHours" Width="100" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Style="{StaticResource CardButtons}">
                            <Button Content="Check" Command="{Binding CheckDisksCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Memory Test -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <ContentControl Content="{Binding Memory}" ContentTemplate="{StaticResource CardHead}" Tag="&#xE964;" Focusable="False" />
                        <StackPanel Style="{StaticResource CardButtons}">
                            <Button Content="Check Last Result" Command="{Binding CheckMemoryCommand}" />
                            <Button Command="{Binding TestMemoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Test Memory" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Windows Component Store -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <ContentControl Content="{Binding ComponentStore}" ContentTemplate="{StaticResource CardHead}" Tag="&#xE7B8;" Focusable="False" />
                        <StackPanel Style="{StaticResource CardButtons}">
                            <Button Content="Check" Command="{Binding CheckComponentStoreCommand}" />
                            <Button Content="Repair" Command="{Binding RepairComponentStoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Windows System Files -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <ContentControl Content="{Binding SystemFiles}" ContentTemplate="{StaticResource CardHead}" Tag="&#xEA18;" Focusable="False" />
                        <StackPanel Style="{StaticResource CardButtons}">
                            <Button Content="Check" Command="{Binding CheckSystemFilesCommand}" />
                            <Button Content="Repair" Command="{Binding RepairSystemFilesCommand}" Style="{StaticResource AccentButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Windows' own messages from the last run. -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding DetailsTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding Details, Mode=OneWay}" AutomationProperties.Name="Details" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0"
                                 Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Details_TextChanged" PreviewMouseWheel="Inner_PreviewMouseWheel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
