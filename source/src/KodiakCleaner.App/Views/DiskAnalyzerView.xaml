<UserControl x:Class="KodiakCleaner.App.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Disk Analyzer" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="See which folders and files take up the most space. Nothing is changed unless you choose to." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Choose Folder…" Command="{Binding BrowseCommand}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding AnalyzeCommand}" Style="{StaticResource AccentButton}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Analyze" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" Tag="Folder or drive to analyze" />
        </DockPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Quick Picks:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ItemsControl ItemsSource="{Binding Places}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Style="{StaticResource LinkButton}" FontSize="12" Margin="0" Padding="6,2"
                                Command="{Binding DataContext.PickPlaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Up One Level" Command="{Binding UpCommand}" />
                            <Button Content="Look Inside" Command="{Binding OpenCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="Folders" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" />
                            <DataGridTemplateColumn Header="Share" Width="2*" SortMemberPath="Bytes">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,8,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Width="48" TextAlignment="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="100" />
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" SortMemberPath="Item.Files" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,8,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Show in Folder" Command="{Binding ShowFileCommand}" />
                            <Button Command="{Binding RecycleFileCommand}" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Move to Recycle Bin" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Largest Files" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding LargestFiles}" SelectedItem="{Binding SelectedFile}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
