<UserControl x:Class="KodiakCleaner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:KodiakCleaner.App"
             xmlns:views="clr-namespace:KodiakCleaner.App.Views">
    <UserControl.Resources>
        <!-- One setting: title + description on the left, control on the right -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

        <CollectionViewSource x:Key="GroupedSections" Source="{Binding Sections}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <app:SectionTemplateSelector x:Key="SectionSelector" />

        <!-- Command Line page: a command shown word by word, so a long one wraps between words and never right after a slash. -->
        <ItemsPanelTemplate x:Key="CodeWordsPanel"><WrapPanel /></ItemsPanelTemplate>
        <DataTemplate x:Key="CodeWord">
            <TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,0,8,0" />
        </DataTemplate>
        <DataTemplate x:Key="CodeLine">
            <ItemsControl ItemsSource="{Binding}" ItemsPanel="{StaticResource CodeWordsPanel}" ItemTemplate="{StaticResource CodeWord}" Focusable="False" />
        </DataTemplate>
        <DataTemplate x:Key="CodeExample">
            <DockPanel Margin="0,6,0,0" TextElement.FontSize="12.5">
                <TextBlock DockPanel.Dock="Left" Text="Example:" Style="{StaticResource Caption}" Margin="0,0,6,0" VerticalAlignment="Top" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CodeLine}" />
            </DockPanel>
        </DataTemplate>
        <!-- Command Line page: one switch with its example and a Copy button. -->
        <DataTemplate x:Key="CliSwitchRow">
            <StackPanel>
                <Border Style="{StaticResource RowDivider}" />
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0" CommandParameter="{Binding Example}"
                            Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            ToolTip="Copy the example with Kodiak Cleaner's full path"
                            AutomationProperties.Name="{Binding Example, StringFormat=Copy {0}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding UsageWords}" ItemTemplate="{StaticResource CodeLine}" TextElement.FontWeight="SemiBold" Focusable="False" />
                        <TextBlock Text="{Binding LinesText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <ContentPresenter Content="{Binding ExampleWords}" ContentTemplate="{StaticResource CodeExample}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </DataTemplate>
        <!-- Command Line page: one page key and the page it opens. -->
        <DataTemplate x:Key="CliPageRow">
            <DockPanel Margin="0,3,12,3" ToolTip="{Binding Argument}">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" FontFamily="Consolas" FontSize="13" Width="112" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ShortTitle}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- ===== Pages. Each template's DataContext is a SettingsSection; Context is its view model. ===== -->

        <DataTemplate x:Key="generalPage">
            <StackPanel DataContext="{Binding Context}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Sidebar" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SidebarAdjustable}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Adjustable Sidebar Width" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Lets you unlock the paperclip and drag the sidebar's edge to make it wider or narrower. Off keeps the default width."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <!-- Favorites (Ted, 2026-10-23): pinned pages at the top of the sidebar, in their own order or A to Z. -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="Favorites Order" Style="{StaticResource SettingTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Favorites stay at the top of the sidebar while the tools below them scroll. Right-click any page in the sidebar to pin or unpin it, or drag it in or out of Favorites. In Default Order, drag favorites or use Move Up and Move Down to set your own order." />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding FavoriteOrders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="FavoritesOrder" Style="{StaticResource Segment}" Content="{Binding Label}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Command="{Binding RestoreFavoritesOrderCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Restore Default Order" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Restore Favorites" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Puts Cleaner, Registry, Startup and Programs back at the top in that order, pinning any you unpinned. Anything else you pinned stays, below them."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}" IsEnabled="{Binding SidebarAdjustable}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSidebarLock}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Show the Paperclip" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="The paperclip at the bottom right of the sidebar locks the width (on its side) or frees it (upright). Off hides it and keeps the sidebar as it is."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="When Kodiak Cleaner Starts" Style="{StaticResource SectionTitle}" />
                    <DockPanel Margin="0,10,0,0" IsEnabled="{Binding CanTurnOffDonationPrompt}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel" BasedOn="{StaticResource SettingRow}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowDonationPrompt}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Remind Me to Support Kodiak Cleaner at Startup" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{Binding DonationPromptCaption}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Visibility="{Binding IsPreRelease, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource RowDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBetaNotice}" />
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Show the Beta Notice at Startup" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Remind you each time Kodiak Cleaner starts that this is beta software." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowWhatsNewAfterUpdate}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Show What's New After Updates" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="The first time Kodiak Cleaner starts after an update, list the changes since your previous version." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyNewStartup}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Tell Me About New Startup Programs" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="When Kodiak Cleaner starts, and every 10 minutes while it's open or in the tray, check for programs that have added themselves to startup. If any have, a pop-up lists them so you can keep, disable or delete each one." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Window and System Tray" Style="{StaticResource SectionTitle}" />
                    <DockPanel Margin="0,10,0,0" Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Close to System Tray" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="The close button hides Kodiak Cleaner in the notification area instead of quitting. Right-click the tray icon and choose Exit to quit." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Minimize to System Tray" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Minimizing hides Kodiak Cleaner in the notification area by the clock. Click the tray icon to bring it back." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Windows Integration" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Shortcuts that let you reach Kodiak Cleaner from other parts of Windows." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <DockPanel Margin="0,10,0,0" Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding JumpList}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Jump List Tasks" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Right-click Kodiak Cleaner on the taskbar or Start menu to jump straight to Run Cleaner, Registry, Startup and the tools." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RecycleBinMenu}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Open Kodiak Cleaner From the Recycle Bin Menu" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Right-click the Recycle Bin to open Kodiak Cleaner. On Windows 11 it is under Show more options." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="cleaningPage">
            <StackPanel DataContext="{Binding Context}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Automatic Cleaning" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CleanOnStartup}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Clean When Windows Starts" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Run a one-time clean with the selected options under Cleaner when you start Windows." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Keep Recent Files" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Files from the last day are often still in use or wanted back." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <DockPanel Margin="0,10,0,0" Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RecycleBinOlderThan24h}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Keep Recycle Bin Files From the Last 24 Hours" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Keeps anything you deleted today, in case you change your mind." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TempOlderThan24h}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Keep Temp Files From the Last 24 Hours" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Programs that are running may still need their newest temp files. Keeping recent ones is safer." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConfirmBeforeCleaning}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Ask Before Cleaning" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Show how much will be deleted and ask for confirmation first." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="updatesPage">
            <StackPanel DataContext="{Binding Context}">
            <!-- The Microsoft Store copy is updated by the Store (2026-10-26): no website checks, no switches. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding ShowWebsiteUpdates, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Automatic Updates" Style="{StaticResource SectionTitle}" />
                    <!-- Two switches (Ted, 0.8.51): checking only tells you; downloading and installing is a separate choice. -->
                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoUpdate}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Check for Updates Automatically" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Check the Kodiak Cleaner website for a new version as often as you choose below, and tell you when one is available. Nothing is downloaded unless the next switch is on." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel IsEnabled="{Binding AutoUpdate}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel" BasedOn="{StaticResource SettingRow}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoInstall}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Download and Install Updates Automatically" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="When a check finds a new version, download it in the background and install it when you close Kodiak Cleaner, which then opens again. Needs Check for Updates Automatically." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <!-- How often to check (Ted, 0.8.44): shortest to longest, the order Ted listed them; a dropdown since 0.8.45 so more fit. -->
                    <StackPanel Margin="0,14,0,0" IsEnabled="{Binding AutoUpdate}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="How Often to Check" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="On Startup checks each time Kodiak Cleaner starts. The others check at start or while it's open, once that long has passed since the last check." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding UpdateIntervals}" DisplayMemberPath="Label" SelectedValuePath="Interval"
                                  SelectedValue="{Binding UpdateInterval}" HorizontalAlignment="Left" MinWidth="200" Margin="0,10,0,0"
                                  AutomationProperties.Name="How Often to Check" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Check Now" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Kodiak Cleaner only goes online when you check, or on the schedule above if Check for Updates Automatically is on." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding ShowWebsiteUpdates, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="This copy came from the Microsoft Store, which installs new versions for you. Check for Updates opens the Store's Downloads page. Kodiak Cleaner itself never goes online." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding IsStore, Converter={StaticResource BoolToVis}}" />
                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Install Update" Command="{Binding InstallUpdateCommand}" Style="{StaticResource AccentButton}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Check Now" Command="{Binding CheckForUpdatesCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Check for Updates" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{Binding LastChecked}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="advancedPage">
            <StackPanel DataContext="{Binding Context}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Administrator Rights" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Some cleaning and fixes need administrator rights. Choose how Kodiak Cleaner gets them." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysAdmin}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Always Start as Administrator" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Every time Kodiak Cleaner starts, it asks Windows for administrator rights. Windows shows its permission prompt each time; decline it and Kodiak Cleaner starts normally." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SkipUac}" IsEnabled="{Binding CanSkipUac}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Skip the User Account Control Prompt" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{Binding SkipUacNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <!-- Reset to Default (Ted, 0.8.59): moved here from the old Developer page. Always the last card. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Reset to Default" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Puts every setting back to how it was when Kodiak Cleaner was first installed, after you confirm, sidebar Favorites included. The start count for the support reminder starts again, so it can be turned off after 10 more starts (never shown to Supporters). Kept: your Supporter code, update bookkeeping, scheduled cleanings, Cleaner history, and every backup, report and log." />
                    <Button Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Reset to Default" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="appearancePage">
            <StackPanel DataContext="{Binding Context}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Accent Color" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Recolors buttons, switches, links and highlights. The first swatch keeps the color scheme's own accent, and the Windows swatch follows your Windows accent color."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <!-- One radio group: Tab enters it once, arrow keys move and pick (SwatchFocused). -->
                        <ItemsControl ItemsSource="{Binding Accents}" Margin="0,10,0,0" KeyboardNavigation.TabNavigation="Once"
                                      KeyboardNavigation.DirectionalNavigation="Cycle" RadioButton.GotKeyboardFocus="SwatchFocused">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Accent" Style="{StaticResource Swatch}" Background="{Binding Brush}"
                                                 ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Color Scheme" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Palettes}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <!-- Same-size tiles filling the width; when the window is too narrow for three (under 150 each) they stack instead of being cut off. -->
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource TileColumns}, ConverterParameter=150}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A tile: Honey always available; Classic, Glacier and Lagoon are Supporter themes, locked for everyone else (shown, not hidden).
                                         Name and description sit at the top of every tile, and the lock chip stays on one line at the bottom
                                         (it shrinks rather than wraps when the window is narrow), so the three tiles line up. -->
                                    <Button Command="{Binding PickCommand}" Margin="0,0,10,10" Padding="0" MinHeight="100" VerticalAlignment="Stretch"
                                            Background="{DynamicResource Surface}" AutomationProperties.Name="{Binding Name}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius}" SnapsToDevicePixels="True">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid Margin="14,12,14,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <Viewbox Grid.Row="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,10,0,0"
                                                     Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                                <Border Style="{StaticResource Chip}" Padding="7,2,8,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0" />
                                                        <TextBlock Text="Supporter Theme" FontSize="11.5" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Viewbox>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Ted's reasons for each color scheme. -->
                        <Border Style="{StaticResource RowDivider}" Margin="0,16,0,12" />
                        <TextBlock Text="Why These Colors" Style="{StaticResource SettingTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0">
                            <Run Text="Honey" FontWeight="SemiBold" /><Run Text=" is inspired by the bear behind Kodiak Cleaner. Its warm golds and creams are part of the Kodiak Cleaner brand." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="Classic" FontWeight="SemiBold" /><Run Text=" is a timeless choice for supporters: crisp white and blue that show a little class without getting in the way." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="Glacier" FontWeight="SemiBold" /><Run Text=" is my thank-you to supporters, with cool, calm blues inspired by the quiet beauty of glacier ice." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="Lagoon" FontWeight="SemiBold" /><Run Text=" is another thank-you to supporters: fresh and clear like shallow water, with ocean blues and aqua, and deep water at night in dark mode." />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Light or Dark" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Match Device follows the app mode set in Windows." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <Border Style="{StaticResource SegmentHost}" Margin="0,12,0,0">
                            <ItemsControl ItemsSource="{Binding Themes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="Theme" Style="{StaticResource Segment}" Content="{Binding Label}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Motion" Style="{StaticResource SectionTitle}" />
                        <DockPanel Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Animations}" />
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Animations" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Off stops every animation, including the logo dance and moving progress bars. Animations also stay off when animation effects are turned off in Windows."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Text Size" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Makes text, icons and buttons bigger or smaller in every Kodiak Cleaner window. It adds to the display scaling set in Windows, which Kodiak Cleaner already follows. The new size is used when you let go of the slider. On a small screen, a window grows only as far as it still fits."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <!-- The size is sent when the slider is let go or moved with the keyboard (TextSizeDragCompleted, TextSizeChanged):
                             the window rescaling while dragging would pull the slider out from under the pointer. -->
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Default Size" Command="{Binding DefaultTextSizeCommand}" Margin="16,0,0,0" />
                            <TextBlock DockPanel.Dock="Right" Width="48" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"
                                       Text="{Binding Value, ElementName=TextSizeSlider, StringFormat={}{0:0}%}" />
                            <TextBlock DockPanel.Dock="Left" Text="A" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                            <TextBlock DockPanel.Dock="Right" Text="A" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                            <Slider x:Name="TextSizeSlider" Minimum="80" Maximum="200" TickFrequency="10" SmallChange="10" LargeChange="20"
                                    Value="{Binding TextSize, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                    AutomationProperties.Name="Text Size" AutomationProperties.HelpText="Percent of the normal size, from 80 to 200."
                                    Thumb.DragCompleted="TextSizeDragCompleted" ValueChanged="TextSizeChanged" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="backupsPage">
            <Border Style="{StaticResource Card}" DataContext="{Binding Context}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0" Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PromptRegistryBackup}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Ask Whether to Back Up Registry Fixes" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="When off, a backup is always saved without asking." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Command="{Binding BackUpRegistryCommand}" Style="{StaticResource AccentButton}" Margin="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Back Up Now" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Back Up the Registry Now" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Saves every area Kodiak Cleaner can change (startup entries, shared DLLs, App Paths, uninstall entries and the MUI cache) into one .reg file. Double-click it to put everything back; areas for all users need administrator rights to restore."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RegistryBackupStatus}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Content="Open Folder" Command="{Binding OpenBackupsCommand}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Registry Backups" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Every registry fix is saved here first. Double-click a .reg file to undo that fix." Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding RegistryBackupFolder}" Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="applicationPage">
            <Border Style="{StaticResource Card}" DataContext="{Binding Context}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="0" Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Content="Back Up Settings" Command="{Binding BackUpSettingsCommand}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Back Up Settings" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Saves a dated copy of KodiakCleaner.ini and your Programs and Startup histories in Backups\Settings. To restore them, close Kodiak Cleaner and copy the backups over KodiakCleaner.ini, Backups\Programs History\history.json and Backups\Startup History\history.json."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SettingsBackupStatus}" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Content="Open Folder" Command="{Binding OpenDataFolderCommand}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Backups, Logs and Reports" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{Binding DataFolderNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <!-- Microsoft Store copy only (2026-10-26): a Store uninstall can't run Kodiak Cleaner's own cleanup like the MSI does. -->
                    <StackPanel Visibility="{Binding IsStore, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource RowDivider}" />
                        <DockPanel Style="{StaticResource SettingRow}">
                            <Button DockPanel.Dock="Right" Content="Remove Windows Changes" Command="{Binding RemoveWindowsChangesCommand}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Before You Uninstall" Style="{StaticResource SettingTitle}" />
                                <TextBlock Text="Turns off everything Kodiak Cleaner set up in Windows: Clean When Windows Starts, the Recycle Bin menu entry, scheduled cleanings and any restart it was waiting for. Windows removes the app and its settings when you uninstall it, but not these."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KeepActivityLog}" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Keep an Activity Log" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Notes what Kodiak Cleaner does (cleanings, registry fixes, backups, startup and program changes, errors) in a monthly file in Logs. It stays on this PC and is never sent anywhere. The last 12 months are kept."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Content="Open Folder" Command="{Binding OpenSettingsFolderCommand}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Settings File" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{Binding SettingsFileNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SettingsFile}" Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Tools (Ted, 0.9.1 Beta): every tool A to Z with a switch; off only hides it from the sidebar. -->
        <DataTemplate x:Key="toolsPage">
            <Border Style="{StaticResource Card}" DataContext="{Binding Context}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ShowAllToolsCommand}" VerticalAlignment="Top" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Show Every Tool" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Tools in the Sidebar" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Turn off the tools you don't use to hide them from Favorites and Tools in the sidebar. Nothing is removed: turn one back on and it returns to the same place. A hidden tool still opens from the jump list or --page=, and the command line and scheduled cleanings keep working." />
                            <TextBlock Text="{Binding HiddenToolsSummary}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ToolChoices}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />
                                    <DockPanel Margin="0,10,0,0">
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsShown}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding SwitchName}" />
                                        <Grid DockPanel.Dock="Left" Width="22" Margin="2,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Left" />
                                            <!-- Drive Wiper's bin over its drive, as in the sidebar. -->
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource Icon}" FontSize="9" FontWeight="Bold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-3"
                                                       Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Command Line (Ted, 0.9.1 Beta): the same switches, exit codes and page keys as KodiakCleaner.exe /help and the README
             (all from CommandLineHelp). Copy puts an example on the clipboard with this copy's full path. -->
        <DataTemplate x:Key="commandlinePage">
            <StackPanel DataContext="{Binding Context}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Commands" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Run these in Command Prompt or PowerShell. They work with no window: the result is written where you typed the command, and the exit code says how it went." />
                    <TextBlock Text="{Binding CliFolderNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CliCopyStatus}" Style="{StaticResource Caption}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasCliCopyStatus, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding CliSwitches}" ItemTemplate="{StaticResource CliSwitchRow}" />
                    <Border Style="{StaticResource RowDivider}" Margin="0,14,0,0" />
                    <TextBlock Text="Set Up by Kodiak Cleaner" Style="{StaticResource SettingTitle}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Kodiak Cleaner adds these to Windows itself (Clean When Windows Starts, the jump list and Task Scheduler). They work typed by hand too." />
                    <ItemsControl ItemsSource="{Binding CliSetUpSwitches}" ItemTemplate="{StaticResource CliSwitchRow}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Exit Codes" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Scripts can read these to see how a command went." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <ItemsControl ItemsSource="{Binding CliExitCodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Code}" FontFamily="Consolas" FontWeight="SemiBold" Width="28" />
                                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Open a Page" Style="{StaticResource SectionTitle}" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0" Command="{Binding CopyCommandCommand}" CommandParameter="{Binding CliPageExample}"
                                ToolTip="Copy the example with Kodiak Cleaner's full path" AutomationProperties.Name="Copy the Open a Page Example">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding CliPageUsageWords}" ItemTemplate="{StaticResource CodeLine}" TextElement.FontWeight="SemiBold" Focusable="False" />
                            <TextBlock Text="{Binding CliPageSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ContentPresenter Content="{Binding CliPageExampleWords}" ContentTemplate="{StaticResource CodeExample}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <TextBlock Text="Pages" Style="{StaticResource SettingTitle}" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding CliPages}" ItemTemplate="{StaticResource CliPageRow}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="Settings Pages" Style="{StaticResource SettingTitle}" Margin="0,14,0,4" />
                    <ItemsControl ItemsSource="{Binding CliSettingsPages}" ItemTemplate="{StaticResource CliPageRow}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Using It in Scripts" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding CliNotes}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="•" Width="16" Foreground="{DynamicResource Muted}" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding CliLogFolder}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="feedbackPage"><views:FeedbackPage DataContext="{Binding Context}" /></DataTemplate>
        <DataTemplate x:Key="supporterPage"><views:SupporterPage DataContext="{Binding Context}" /></DataTemplate>
        <DataTemplate x:Key="faqPage"><views:DocumentView DataContext="{Binding Context}" /></DataTemplate>
        <DataTemplate x:Key="termsPage"><views:DocumentView DataContext="{Binding Context}" /></DataTemplate>
        <DataTemplate x:Key="privacyPage"><views:DocumentView DataContext="{Binding Context}" /></DataTemplate>
        <DataTemplate x:Key="storyPage"><views:DocumentView DataContext="{Binding Context}" /></DataTemplate>
        <DataTemplate x:Key="ElementPage"><ContentPresenter Content="{Binding Context}" /></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <!-- Drag the grip to widen or narrow the Settings list (Ted, 0.8.99). -->
        <GridSplitter Grid.Column="1" Style="{StaticResource PaneColumns}" views:PaneSplitter.Remember="settings" />

        <!-- Settings sidebar -->
        <DockPanel Margin="-12,0,0,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <!-- A divider with space on both sides sets Support Kodiak Cleaner and the privacy note apart from the pages
                     above, like the one over Settings and About in the main sidebar (Ted, 0.8.39). -->
                <Border Height="1" Margin="12,4,12,14" Background="{DynamicResource Line}" />
                <Button Style="{StaticResource LinkButton}" Command="{Binding SupportCommand}" HorizontalAlignment="Left" Margin="12,0,0,6"
                        Visibility="{Binding ShowSupportLink, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SupportLinkText}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding PrivacyNote}" Style="{StaticResource Caption}" Width="170" />
                </StackPanel>
            </StackPanel>
            <!-- Search (Ted, 0.8.45): always above General, outside the scrolling list. Enter opens the first match, Esc clears. -->
            <StackPanel DockPanel.Dock="Top" Margin="12,0,0,10">
                <views:SearchBox x:Name="Search" Text="{Binding SearchQuery}" Placeholder="Search settings"
                                 PreviewKeyDown="Search_PreviewKeyDown" AutomationProperties.Name="Search Settings" />
                <TextBlock Text="No settings match." Style="{StaticResource Caption}" Margin="4,8,0,0"
                           Visibility="{Binding NoMatches, Converter={StaticResource BoolToVis}}" />
                <!-- Sort By (Ted, 2026-10-23): Default puts General first, then the most used pages; A to Z sorts each heading. -->
                <DockPanel Margin="4,10,0,0">
                    <TextBlock Text="Sort By" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding SectionSorts}" SelectedItem="{Binding SectionSort}" HorizontalAlignment="Left" MinWidth="120"
                              AutomationProperties.Name="Sort Settings By" />
                </DockPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedSections}}" Focusable="False" KeyboardNavigation.TabNavigation="Once">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource GroupHeading}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="SettingsNav" Style="{StaticResource NavButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,12,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding SearchHint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="150">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchHint}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Current page -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock Text="{Binding CurrentSection.Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding CurrentSection.Description}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Border DockPanel.Dock="Top" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius}" Padding="12,10" Margin="0,0,0,16"
                    MaxWidth="840" HorizontalAlignment="Left" Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap" />
            </Border>

            <!-- Footer: copyright, then the license on its own line (Terms of Use lives under Help). -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{Binding Footer}" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding LicenseLine}" Style="{StaticResource Caption}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Focusable="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="840" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding CurrentSection}" ContentTemplateSelector="{StaticResource SectionSelector}" Focusable="False" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
