<Window x:Class="KodiakCleaner.App.DiskAnalyzerPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KodiakCleaner.App.Views"
        Title="Choose What to Analyze" Width="760" Height="660" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Disk Analyzer > Choose What to Analyze (Ted, 2026-10-12; dropdown and fixed size 2026-10-22): All Drives, Folder or Individual Drives from a
         dropdown, then drive cards (scrolling inside the fixed-size window, however many drives there are) or a folder box. -->
    <Window.Resources>
        <!-- A drive: a card that ticks on click, with how full the drive is. -->
        <Style x:Key="DriveCard" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                                CornerRadius="{DynamicResource Radius}" Padding="14,12">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="Tick" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Success}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                    <Path Data="M 5,10 L 8.5,13.5 L 15,6.5" Stroke="{DynamicResource OnSuccess}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEB05;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                <TextBlock Text="Choose What to Analyze" Style="{StaticResource PageTitle}" FontSize="22" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="Pick every drive, the drives you tick, or one folder. Kodiak Cleaner only reads sizes; nothing is changed." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="AnalyzeButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Margin="0" IsDefault="True" Click="Analyze_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEB05;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Analyze" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" />
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="Analyze" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox x:Name="ModeBox" DockPanel.Dock="Left" Width="250" SelectionChanged="Mode_Changed" AutomationProperties.Name="What to Analyze">
                    <ComboBoxItem x:Name="AllMode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="All Drives" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem x:Name="FolderMode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem x:Name="DrivesMode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentText}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Individual Drives" VerticalAlignment="Center" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>
                <TextBlock x:Name="ModeCaption" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16,0,0,0" />
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <DockPanel x:Name="DrivePanel">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel x:Name="DriveButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Select All" Padding="12,4" Margin="8,0,0,0" Click="SelectAll_Click" />
                                <Button Content="Clear" Padding="12,4" Margin="8,0,0,0" Click="Clear_Click" />
                            </StackPanel>
                            <TextBlock x:Name="DriveHint" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="Loading" DockPanel.Dock="Top" Text="Reading drives…" Style="{StaticResource Caption}" />
                        <!-- The window keeps its size; a long list of drives scrolls here instead of running off the screen. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,-12,0" Padding="0,0,12,0">
                        <ItemsControl views:Placeholder.Text="Drives show here once they answer. Choose Folder to analyze a folder instead." x:Name="Drives" Margin="0,0,-10,-10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DriveCard}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsReady}" Click="Drive_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="26"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                                <ProgressBar Value="{Binding Used, Mode=OneWay}" Maximum="100" Height="7" Margin="0,8,0,4" />
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedText}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding Space}" Style="{StaticResource Caption}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <StackPanel x:Name="FolderPanel" Visibility="Collapsed">
                        <TextBlock Text="Folder to Analyze" Style="{StaticResource SettingTitle}" Margin="0,0,0,8" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="10,0,0,0" Click="Browse_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Browse…" />
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="FolderBox" Tag="Folder to analyze, for example C:\Users" TextChanged="FolderBox_TextChanged" />
                        </DockPanel>
                        <TextBlock Text="Your Folders" Style="{StaticResource SettingTitle}" Margin="0,18,0,8" />
                        <ItemsControl x:Name="Places">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Path}" Click="Place_Click" Margin="0,0,8,8" Padding="12,5" ToolTip="{Binding Path}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentText}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
