<Window x:Class="KodiakCleaner.App.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support Kodiak Cleaner" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Shown at startup (Ted, 0.8.55; softer wording 0.8.118, it never says "donate"). The X, Esc and Not Now all close it; the switch can only stop it after 10 launches. -->
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="Support Kodiak Cleaner" Style="{StaticResource PageTitle}" FontSize="22" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="Kodiak Cleaner is free and open source, with no ads, no tracking and nothing held back behind a paywall. It's built in spare time by one person." />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"
                           Text="If it helps you, please consider supporting Kodiak Cleaner on Ko-fi. It's completely optional, and every feature stays free either way." />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource Caption}" FontSize="13"
                           Text="Ko-fi opens in your browser. Supporters get a few extras as a thank-you, and this reminder turns off for good." />
            </StackPanel>
        </Border>

        <DockPanel Margin="0,20,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Not Now" IsCancel="True" Click="Close_Click" />
                <Button Style="{StaticResource AccentButton}" Margin="0" IsDefault="True" Click="Donate_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB51;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Support on Ko-fi" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <DockPanel Margin="0,16,0,0">
            <CheckBox x:Name="DontShowAgain" DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="0,2,0,0"
                      AutomationProperties.Name="Don't Show This Again at Startup" />
            <StackPanel Margin="10,0,0,0">
                <TextBlock x:Name="DontShowLabel" Text="Don't Show This Again at Startup" />
                <TextBlock x:Name="Hint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
