<Window x:Class="KodiakCleaner.App.DriveDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drive Details" Width="700" Height="680" MinWidth="480" MinHeight="380"
        Icon="pack://application:,,,/Assets/app.ico" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontBody}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Drive Wiper > the info button on a drive's row (Ted, 0.8.116): a read-only summary of the drive. -->
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentText}" Margin="0,0,12,0" />
                <TextBlock Text="Drive Details" Style="{StaticResource PageTitle}" FontSize="22" />
            </StackPanel>
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False" ToolTip="Copy this summary to the clipboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Content="Close" Style="{StaticResource AccentButton}" Margin="0" IsDefault="True" IsCancel="True" Click="Close_Click" />
            </StackPanel>
            <TextBlock x:Name="CopyNote" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <!-- Space on the content, not the ScrollViewer's Padding, so focus rings at the edge aren't clipped (as in Mass Rename). -->
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Sections" Margin="22,18,16,18">
                    <TextBlock x:Name="Reading" Text="Reading the drive's details, health report and logged errors…" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
