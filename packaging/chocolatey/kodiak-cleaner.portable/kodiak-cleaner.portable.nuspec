<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>kodiak-cleaner.portable</id>
    <!-- Filled in by .github/workflows/store-packages.yml from the release tag. A -beta or -dev suffix makes Chocolatey
         treat it as a pre-release; a plain 1.0.0 is stable. -->
    <version>__VERSION__</version>
    <title>Kodiak Cleaner (Portable)</title>
    <authors>Ted Tabaka</authors>
    <owners>TTabakaGroup</owners>
    <projectUrl>https://www.kodiakcleaner.app/</projectUrl>
    <projectSourceUrl>https://github.com/ttabakagroup/kodiak-cleaner</projectSourceUrl>
    <packageSourceUrl>https://github.com/ttabakagroup/kodiak-cleaner/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://www.kodiakcleaner.app/features/</docsUrl>
    <bugTrackerUrl>https://www.kodiakcleaner.app/contact/</bugTrackerUrl>
    <releaseNotes>https://www.kodiakcleaner.app/changelog/</releaseNotes>
    <iconUrl>https://raw.githubusercontent.com/ttabakagroup/kodiak-cleaner/main/assets/logo/github/kodiak-cleaner-logo-512.png</iconUrl>
    <licenseUrl>https://github.com/ttabakagroup/kodiak-cleaner/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
