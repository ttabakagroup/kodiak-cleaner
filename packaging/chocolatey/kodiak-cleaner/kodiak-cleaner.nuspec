<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>kodiak-cleaner</id>
    <!-- Filled in by .github/workflows/store-packages.yml from the release tag. A -beta or -dev suffix makes Chocolatey
         treat it as a pre-release; a plain 1.0.0 is stable. -->
    <version>__VERSION__</version>
    <title>Kodiak Cleaner</title>
    <authors>Ted Tabaka</authors>
    <owners>TTabakaGroup</owners>
    <projectUrl>https://www.kodiakcleaner.app/</projectUrl>
    <projectSourceUrl>https://github.com/ttabakagroup/kodiakcleaner</projectSourceUrl>
    <packageSourceUrl>https://github.com/ttabakagroup/kodiakcleaner/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://www.kodiakcleaner.app/features/</docsUrl>
    <bugTrackerUrl>https://www.kodiakcleaner.app/contact/</bugTrackerUrl>
    <releaseNotes>https://www.kodiakcleaner.app/changelog/</releaseNotes>
    <iconUrl>https://raw.githubusercontent.com/ttabakagroup/kodiakcleaner/main/assets/logo/github/kodiak-cleaner-logo-512.png</iconUrl>
    <licenseUrl>https://github.com/ttabakagroup/kodiakcleaner/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright (c) Ted Tabaka</copyright>
    <tags>kodiak-cleaner cleaner disk-cleanup junk-files startup-manager uninstaller privacy open-source foss admin</tags>
    <summary>A small, honest PC cleaner with no telemetry and no ads.</summary>
    <description><![CDATA[Kodiak Cleaner clears junk files, browser caches and leftovers, manages startup programs and installed programs, and includes tools such as Disk Analyzer, Duplicate Finder, Drive Wiper and Boot Timer.

It has no telemetry, no ads and no upsells. Free and open source under the MIT License.

__NOTE__

This package installs Kodiak Cleaner with its Windows installer (MSI). For a version that runs without installing, see the kodiak-cleaner.portable package.
]]></description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
